# emetteur.rose — jalon M4.3 : l'émetteur RIR auto-hébergé ROSE.
#
# Lit le programme passé en argument et rejoue TOUTE la chaîne du moteur :
# lexage, analyse descendante (AST en pools de nœuds plats), repli de
# constantes (les flottants repliés portent le texte exact que le moteur
# écrit dans le RIR), vérification de types — enrichie de deux notes :
# le type vérifié de chaque nœud et le type de lecture de chaque « lire » —
# puis ÉMISSION : le dump RIR octet pour octet de l'oracle `rose rir`.
# Rejet : le message exact, comme verifieur.rose. Validation :
# moteur/tests/emetteur.py — les 103 fichiers de verifieur.py plus
# l'émetteur lui-même, par les trois voies.
#
# DISCIPLINES (M4.0/M4.1) : pas de courts-circuits (tout index dangereux est
# abrité) ; aucune globale visible des fonctions (tout voyage en paramètre) ;
# listes rembourrées à l'index 0 (le vérificateur refuse []) ; on ne peut que
# joindre — les pools sont construits en post-ordre, un indice de nœud n'est
# jamais réécrit. Erreurs : liste partagée $err — la première gagne, les
# appels suivants passent à vide (garde d'entrée partout).
#
# Pools de nœuds : listes parallèles, le nœud i est à la position i+1.
# Champs : genre (lit/ch/bol/v/lst/idx/uni/fac/app/bin), texte brut, drapeau
# flottant, indices gauche/droite, arguments (pool $al, départ $as, nombre
# $ac), ligne. Instructions : aff/lire/affi/si/tq/pour/retour/expr/bloc, nom,
# deux expressions, deux corps (indices séparés par des virgules), ligne.
# Types encodés « base|élément ».

# ══════════════════ lexage — utilitaires miroir ══════════════════

fn est_chiffre(c: entier) -> booleen {
  retour c >= 48 et c <= 57
}

fn est_lettre(c: entier) -> booleen {
  si (c < 128) {
    retour (c >= 65 et c <= 90) ou (c >= 97 et c <= 122) ou c == 95
  }
  retour (c >= 192 et c <= 214) ou (c >= 216 et c <= 246) ou (c >= 248 et c <= 767) ou (c >= 880 et c <= 1279) ou (c >= 7680 et c <= 8191)
}

fn est_suite(c: entier) -> booleen {
  si (c < 128) {
    retour est_lettre(c) ou est_chiffre(c)
  }
  retour est_lettre(c)
}

fn paire(a: entier, b: entier) -> chaine {
  si (a == 60 et b == 61) { retour "<=" }
  si (a == 62 et b == 61) { retour ">=" }
  si (a == 61 et b == 61) { retour "==" }
  si (a == 33 et b == 61) { retour "!=" }
  si (a == 47 et b == 61) { retour "!=" }
  si (a == 63 et b == 61) { retour "?=" }
  si (a == 61 et b == 126) { retour "=~" }
  si (a == 126 et b == 61) { retour "=~" }
  retour ""
}

fn uni(c: entier) -> chaine {
  si (c == 8776) { retour "≈" }
  si (c == 8804) { retour "<=" }
  si (c == 8805) { retour ">=" }
  si (c == 8800) { retour "!=" }
  si (c == 215) { retour "*" }
  si (c == 8901) { retour "*" }
  si (c == 183) { retour "*" }
  si (c == 247) { retour "div" }
  si (c == 8592) { retour "=" }
  si (c == 8594) { retour "->" }
  si (c == 8730) { retour "racine" }
  retour ""
}

fn car(c: entier) -> chaine {
  si (c == 43) { retour "+" }
  si (c == 45) { retour "-" }
  si (c == 42) { retour "*" }
  si (c == 47) { retour "/" }
  si (c == 58) { retour ":" }
  si (c == 37) { retour "%" }
  si (c == 94) { retour "^" }
  si (c == 33) { retour "!" }
  si (c == 46) { retour "." }
  si (c == 44) { retour "," }
  si (c == 63) { retour "?" }
  si (c == 40) { retour "(" }
  si (c == 41) { retour ")" }
  si (c == 123) { retour "{" }
  si (c == 125) { retour "}" }
  si (c == 91) { retour "[" }
  si (c == 93) { retour "]" }
  si (c == 59) { retour ";" }
  si (c == 60) { retour "<" }
  si (c == 62) { retour ">" }
  si (c == 126) { retour "~" }
  si (c == 64) { retour "@" }
  retour ""
}

# ——— lectureurs de la table de jetons (claqués sur l'eof) ———

fn T0($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn VX0($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn T1($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p + 1
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn VX1($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p + 1
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn GL0($gl: liste<entier>, $p: entier) -> entier {
  $n = longueur($gl)
  $q = $p
  si ($q >= $n) { $q = $n - 1 }
  retour $gl[$q]
}

fn EMOT($g: liste<chaine>, $x: liste<chaine>, $p: entier, $m: chaine) -> booleen {
  $t = T0($g, $p)
  retour ($t == "ident" ou $t == "mot") et VX0($x, $p) == $m
}

# ——— décodage du couple « position|nœud » (les nœuds sont des entiers ici) ———

fn SEPR($r: chaine) -> entier {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour entier(sous_chaine($r, 0, $q))
}

fn NOD($r: chaine) -> chaine {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour sous_chaine($r, $q + 1, $n)
}

# ══════════════════ types « base|élément » ══════════════════

fn nomty($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  $base = sous_chaine($v, 0, $k)
  $elt = sous_chaine($v, $k + 1, $n)
  si ($base != "liste") { retour $base }
  si ($elt == "liste") { retour "liste<liste<vide>>" }
  retour "liste<" + $elt + ">"
}

fn BASE($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour sous_chaine($v, 0, $k)
}

fn tyb($b: chaine) -> chaine {
  retour $b + "|vide"
}

fn estnum($t: chaine) -> booleen {
  $b = BASE($t)
  retour $b == "entier" ou $b == "rationnel" ou $b == "flottant"
}

fn contient_barre($v: chaine) -> booleen {
  $n = longueur($v)
  $k = 0
  $trouve = 0
  tant_que ($k < $n) {
    si (ordre($v[$k]) == 47) { $trouve = 1 }
    $k = $k + 1
  }
  retour $trouve == 1
}

fn rangd($b: chaine) -> entier {
  si ($b == "booleen") { retour 0 }
  si ($b == "entier") { retour 1 }
  si ($b == "rationnel") { retour 2 }
  si ($b == "flottant") { retour 3 }
  retour -1
}

fn promote($u1: chaine, $u2: chaine) -> chaine {
  $r1 = rangd(BASE($u1))
  $r2 = rangd(BASE($u2))
  $r = $r1
  si ($r2 > $r) { $r = $r2 }
  si ($r <= 1) { retour "entier|vide" }
  si ($r == 2) { retour "rationnel|vide" }
  retour "flottant|vide"
}

# ══════════════════ morceaux de chaînes (, et ;) ══════════════════

fn piece($s: chaine, $sep: entier, $k: entier) -> chaine {
  $n = longueur($s)
  $j = 0
  $no = 1
  $buf = ""
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) {
      si ($no == $k) { retour $buf }
      $no = $no + 1
      $buf = ""
    }
    sinon { $buf = $buf + $s[$j] }
    $j = $j + 1
  }
  si ($no == $k) { retour $buf }
  retour ""
}

fn nb_pieces($s: chaine, $sep: entier) -> entier {
  si ($s == "") { retour 0 }
  $n = longueur($s)
  $j = 0
  $c = 0
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) { $c = $c + 1 }
    $j = $j + 1
  }
  retour $c + 1
}

# ══════════════════ arithmétique rationnelle exacte (repli) ══════════════════
# L'entier Rose est à précision arbitraire (GMP côté moteur) : le repli est
# EXACT sans bignum dédié — fraction « p » ou « p/q », dénominateur > 0,
# réduite, zéro sous la forme « 0 » — canonicalisation mpq miroir.

fn vabs($x: entier) -> entier {
  si ($x < 0) { retour 0 - $x }
  retour $x
}

fn pgcd2($a: entier, $b: entier) -> entier {
  $x = vabs($a)
  $y = vabs($b)
  tant_que ($y > 0) {
    $r = $x % $y
    $x = $y
    $y = $r
  }
  retour $x
}

fn rpui($b: entier, $e: entier) -> entier {
  $res = 1
  $f = $b
  $k = $e
  tant_que ($k > 0) {
    si ($k % 2 == 1) { $res = $res * $f }
    $f = $f * $f
    $k = $k div 2
  }
  retour $res
}

fn rnum($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour entier(sous_chaine($t, 0, $k))
}

fn rden($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour 1 }
  retour entier(sous_chaine($t, $k + 1, $n))
}

# zéro rationnel : tous les chiffres du numérateur sont des « 0 »
fn rnul($t: chaine) -> booleen {
  $n = longueur($t)
  $k = 0
  $ok = 1
  $rien = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon si (ordre($t[$k]) != 48) { $ok = 0; $rien = 0 }
    sinon { $k = $k + 1 }
  }
  retour $rien == 1
}

fn rnorm($p: entier, $q: entier) -> chaine {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour "0" }
  $g = pgcd2($np, $nq)
  si ($g > 1) { $np = $np div $g; $nq = $nq div $g }
  si ($nq == 1) { retour chaine($np) }
  retour chaine($np) + "/" + chaine($nq)
}

# ══════════════════ erreurs et environnements ══════════════════
# $err : liste partagée, la première erreur gagne ; toute fonction gardée
# rend la main à vide dès qu'elle est pleine (miroir de l'exception C++).

fn lever($lg: entier, $msg: chaine, $err: liste<chaine>) {
  si (longueur($err) == 1) {
    $s = "Rose : erreur — "
    si ($lg > 0) { $s = $s + "[Ligne " + chaine($lg) + ", Colonne 0] " }
    joindre($err, $s + $msg)
  }
}

fn reserver($nom: chaine, $lg: entier, $err: liste<chaine>) {
  $n = longueur($nom)
  si ($n > 1 et ordre($nom[0]) == 116) {
    $chiffres = 1
    $k = 1
    tant_que ($k < $n) {
      si ($chiffres == 1) {
        $c = ordre($nom[$k])
        si ($c < 48 ou $c > 57) { $chiffres = 0 }
      }
      $k = $k + 1
    }
    si ($chiffres == 1) { lever($lg, "Le nom '" + $nom + "' est réservé par le moteur", $err) }
  }
}

fn env_get($nom: chaine, $vn: liste<chaine>, $vt: liste<chaine>) -> chaine {
  $j = longueur($vn) - 1
  tant_que ($j >= 1) {
    si ($vn[$j] == $nom) { retour $vt[$j] }
    $j = $j - 1
  }
  retour ""
}

fn env_put($nom: chaine, $ty: chaine, $vn: liste<chaine>, $vt: liste<chaine>) {
  joindre($vn, $nom)
  joindre($vt, $ty)
}

# ══════════════════ appendeurs de pools ══════════════════
# Post-ordre strict : le nœud est ajouté quand ses enfants existent déjà ;
# indice = longueur - 1 après l'ajout (listes rembourrées).

fn noeud8($k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $kd: chaine, $t: chaine, $f: chaine,
          $ga: entier, $gb: entier, $sa: entier, $ca: entier, $l: entier) -> entier {
  joindre($k, $kd)
  joindre($tx, $t)
  joindre($tf, $f)
  joindre($a, $ga)
  joindre($b, $gb)
  joindre($as, $sa)
  joindre($ac, $ca)
  joindre($lg, $l)
  retour longueur($k) - 1
}

fn inoeud7($ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
           $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
           $kd: chaine, $no: chaine, $e1: entier, $e2: entier,
           $b1: chaine, $b2: chaine, $l: entier) -> entier {
  joindre($ik, $kd)
  joindre($ino, $no)
  joindre($ie, $e1)
  joindre($ie2, $e2)
  joindre($ib1, $b1)
  joindre($ib2, $b2)
  joindre($ilg, $l)
  retour longueur($ik) - 1
}

# module::nom est stocké « module;nom » (les identifiants ne portent jamais « ; »)
fn eclate_mod($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour "" }
  retour sous_chaine($t, 0, $k)
}

fn eclate_nom($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour $t }
  retour sous_chaine($t, $k + 1, $n)
}

# ══════════════════ types et noms (parseur) ══════════════════

fn nomid($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  retour chaine($p + 1) + "|" + VX0($x, $p)
}

# type annoté : « pos|base|élément » — Ty::liste ne garde que la base de
# l'élément (miroir de la plie M4.1)
fn typex($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  $r = nomid($g, $x, $p)
  $q = SEPR($r)
  $t = NOD($r)
  si ($t == "liste") {
    si (T0($g, $q) == "<") { $q = $q + 1 }
    $d = typex($g, $x, $q)
    $q = SEPR($d)
    $iv = NOD($d)
    si (T0($g, $q) == ">") { $q = $q + 1 }
    $m = longueur($iv)
    $k = 0
    $trouve = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($k >= $m) { $ok = 0 }
      sinon si (ordre($iv[$k]) == 124) { $ok = 0; $trouve = 1 }
      sinon { $k = $k + 1 }
    }
    $base_int = $iv
    si ($trouve == 1) { $base_int = sous_chaine($iv, 0, $k) }
    retour chaine($q) + "|liste|" + $base_int
  }
  retour chaine($q) + "|" + $t + "|vide"
}

# ══════════════════ expressions — descente vers les pools ══════════════════
# Toute fonction rend « pos|indice » ; l'indice est décimal (jamais de « | »).

fn atom($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "nombre") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "flottant") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", VX0($x, $p), "1", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "chaine") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "ch", VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "[") {
    # arguments d'abord dans un tampon local (frais par cadre recursive),
    # vidange contiguë vers le pool $al a la fermeture du nœud
    $col = [-1]
    $nc = 0
    $q = $p + 1
    si (T1($g, $p) != "]") {
      $ok = 1
      tant_que ($ok == 1) {
        $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        joindre($col, entier(NOD($r)))
        $nc = $nc + 1
        $q = SEPR($r)
        si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $ok = 0 }
      }
    }
    si (T0($g, $q) == "]") { $q = $q + 1 }
    $sa = longueur($al)
    $u = 1
    tant_que ($u <= $nc) {
      joindre($al, $col[$u])
      $u = $u + 1
    }
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lst", "", "", -1, -1, $sa, $nc, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "(") {
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    retour chaine($q) + "|" + NOD($r)
  }
  si (VX0($x, $p) == "vrai") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "1", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (VX0($x, $p) == "faux") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "0", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (T1($g, $p) == "::") {
    $mod = VX0($x, $p)
    $nom = VX1($x, $p + 1)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, longueur($al), 0, $l)
    retour chaine($p + 3) + "|" + chaine($i)
  }
  $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "v", VX0($x, $p), "", -1, -1, 0, 0, $l)
  retour chaine($p + 1) + "|" + chaine($i)
}

fn can_nud($k: liste<chaine>, $ac: liste<entier>, $e: entier) -> booleen {
  $kk = $k[$e]
  si ($kk == "v") { retour vrai }
  retour $kk == "app" et $ac[$e] == 0
}

fn post($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = atom($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "(" et can_nud($k, $ac, $e)) {
      $lp = GL0($gl, $q)
      $tx0 = $tx[$e]
      $mod = eclate_mod($tx0)
      $nom = eclate_nom($tx0)
      $q = $q + 1
      $col = [-1]
      $nc = 0
      si (T0($g, $q) != ")") {
        $v2 = 1
        tant_que ($v2 == 1) {
          $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          joindre($col, entier(NOD($rr)))
          $nc = $nc + 1
          $q = SEPR($rr)
          si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $v2 = 0 }
        }
      }
      si (T0($g, $q) == ")") { $q = $q + 1 }
      $sa = longueur($al)
      $u = 1
      tant_que ($u <= $nc) {
        joindre($al, $col[$u])
        $u = $u + 1
      }
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, $sa, $nc, $lp)
    }
    sinon si ($t == "[") {
      $lb = GL0($gl, $q)
      $q = $q + 1
      si (T0($g, $q) == ":") {
        # s[:b] et s[:] — sucre miroir : sous_chaine(s, 0, b)
        $q = $q + 1
        $fin = -1
        si (T0($g, $q) == "]") {
          joindre($al, $e)
          $fin = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
        }
        sinon {
          $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          $fin = entier(NOD($rr))
          $q = SEPR($rr)
        }
        joindre($al, $e)
        $z = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0", "", -1, -1, 0, 0, $lb)
        joindre($al, $z)
        joindre($al, $fin)
        $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
        si (T0($g, $q) == "]") { $q = $q + 1 }
      }
      sinon {
        $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        $ix = entier(NOD($rr))
        $q = SEPR($rr)
        si (T0($g, $q) == ":") {
          # s[a:b] et s[a:] — sucre miroir
          $q = $q + 1
          $fin = -1
          si (T0($g, $q) == "]") {
            joindre($al, $e)
            $fin = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
          }
          sinon {
            $r3 = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
            $fin = entier(NOD($r3))
            $q = SEPR($r3)
          }
          joindre($al, $e)
          joindre($al, $ix)
          joindre($al, $fin)
          $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
          si (T0($g, $q) == "]") { $q = $q + 1 }
        }
        sinon {
          $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "idx", "", "", $e, $ix, 0, 0, $lb)
          si (T0($g, $q) == "]") { $q = $q + 1 }
        }
      }
    }
    sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn unai($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "racine") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    $d = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0.5", "1", -1, -1, 0, 0, $l)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", entier(NOD($r)), $d, 0, 0, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "-") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "-", "", entier(NOD($r)), -1, 0, 0, $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "+") {
    retour unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  $r = post($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (T0($g, $q) == "!") {
    $lf = GL0($gl, $q)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "fac", "", "", $e, -1, 0, 0, $lf)
    $q = $q + 1
  }
  retour chaine($q) + "|" + chaine($e)
}

fn puis($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = unai($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  si (T0($g, $q) == "^") {
    $lo = GL0($gl, $q)
    $d = puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", $e, entier(NOD($d)), 0, 0, $lo)
    retour chaine(SEPR($d)) + "|" + chaine($i)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn prod($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = puis($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "*" ou $t == "/" ou $t == "%" ou $t == "div") { $op = $t }
    si ($t == "ident" et VX0($x, $q) == "div") { $op = "div" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn somme($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = prod($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "+") { $op = "+" }
    si ($t == "-") { $op = "-" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = prod($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn compa($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = somme($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "<" ou $t == "<=" ou $t == ">" ou $t == ">=" ou $t == "==" ou $t == "!=" ou $t == "≈" ou $t == "?=" ou $t == "=~") { $op = $t }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = somme($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn nonx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  si (EMOT($g, $x, $p, "non")) {
    $l = GL0($gl, $p)
    $r = nonx($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "non", "", entier(NOD($r)), -1, 0, 0, $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  retour compa($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
}

# « et »/« ou » : le nœud porte la ligne du PREMIER jeton de l'opérande
# droit (miroir exact de neo(voir().ligne) après consommation).

fn etx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = nonx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (EMOT($g, $x, $q, "et")) {
    $lo = GL0($gl, $q + 1)
    $d = nonx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "et", "", $e, entier(NOD($d)), 0, 0, $lo)
    $q = SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn expr1($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = etx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (EMOT($g, $x, $q, "ou")) {
    $lo = GL0($gl, $q + 1)
    $d = etx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "ou", "", $e, entier(NOD($d)), 0, 0, $lo)
    $q = SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

# ══════════════════ instructions — pool + corps en chaînes d'indices ══════════════════
# Un corps est la chaîne des indices de ses instructions de premier niveau,
# séparées par « , » ; les instructions imbriquées vivent dans le même pool,
# ajoutées AVANT leur parent (post-ordre), donc hors de la chaîne du parent.

fn instruction($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "{") {
    $c = bloc($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "bloc", "", -1, -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == ">>") {
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "aff", "", entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "<<") {
    $rn = nomid($g, $x, $p + 1)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "lire", NOD($rn), -1, -1, "", "", $l)
    retour chaine(SEPR($rn)) + "|" + chaine($i)
  }
  si ($t == "?") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "@") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "si") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $q = SEPR($c)
    $corps1 = NOD($c)
    $corps2 = ""
    si (EMOT($g, $x, $q, "sinon")) {
      si (T0($g, $q + 1) == "{") {
        $d = bloc($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($d)
        $corps2 = NOD($d)
      }
      sinon {
        $d = instruction($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($d)
        $corps2 = NOD($d)
      }
    }
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(NOD($r)), -1, $corps1, $corps2, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "tant_que") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "pour") {
    $q = $p + 1
    $rn = nomid($g, $x, $q)
    $q = SEPR($rn)
    $nom = NOD($rn)
    si (EMOT($g, $x, $q, "de")) { $q = $q + 1 }
    $rd = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($rd)
    si (EMOT($g, $x, $q, "vers")) { $q = $q + 1 }
    $rf = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($rf)
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "pour", $nom, entier(NOD($rd)), entier(NOD($rf)), NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "retour") {
    $suiv = T1($g, $p)
    si ($suiv == ";" ou $suiv == "}" ou $suiv == "eof") {
      $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", -1, -1, "", "", $l)
      retour chaine($p + 1) + "|" + chaine($i)
    }
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si (($t == "ident" ou $t == "mot") et T1($g, $p) == "=") {
    $rn = nomid($g, $x, $p)
    $q = SEPR($rn)
    si (T0($g, $q) == "=") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "affi", NOD($rn), entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  $r = expr1($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "expr", "", entier(NOD($r)), -1, "", "", $l)
  retour chaine(SEPR($r)) + "|" + chaine($i)
}

fn bloc($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>,
        $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
        $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (T0($g, $q) == "{") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "}" ou $t == "eof") { $ok = 0 }
    sinon {
      si ($t == ";") { $q = $q + 1 }
      sinon {
        $r = instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($r)
        si ($ch != "") { $ch = $ch + "," }
        $ch = $ch + NOD($r)
        si (T0($g, $q) == ";") { $q = $q + 1 }
      }
    }
  }
  si (T0($g, $q) == "}") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

fn corps_chevron($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (T0($g, $q) == "[") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "]" ou $t == "eof") { $ok = 0 }
    sinon {
      $r = instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
      $q = SEPR($r)
      si ($ch != "") { $ch = $ch + "," }
      $ch = $ch + NOD($r)
      si (T0($g, $q) == ";") { $q = $q + 1 } sinon { $ok = 0 }
    }
  }
  si (T0($g, $q) == "]") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

# ══════════════════ définition de fonction ══════════════════
# Pools parallèles : noms, externe (« 1 » ou vide), paramètres encodés
# « nom|base|elt;… », retour « base|elt », corps (chaîne d'indices), ligne du
# jeton « fn » (les erreurs de frontière la réclament).

fn def_fn($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
          $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $al: liste<entier>,
          $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
          $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
          $fnoms: liste<chaine>, $fext: liste<chaine>, $fparams: liste<chaine>,
          $fret: liste<chaine>, $fcorps: liste<chaine>, $fligne: liste<entier>) -> chaine {
  $lf = GL0($gl, $p)
  $q = $p + 1
  $rn = nomid($g, $x, $q)
  $q = SEPR($rn)
  $nom = NOD($rn)
  si (T0($g, $q) == "(") { $q = $q + 1 }
  $params = ""
  $un = 1
  tant_que ($un == 1) {
    si (T0($g, $q) == ")" ou T0($g, $q) == "eof") { $un = 0 }
    sinon {
      $rp = nomid($g, $x, $q)
      $q = SEPR($rp)
      $pn = NOD($rp)
      si (T0($g, $q) == ":") { $q = $q + 1 }
      $rt = typex($g, $x, $q)
      $q = SEPR($rt)
      si ($params != "") { $params = $params + ";" }
      $params = $params + $pn + "|" + NOD($rt)
      si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $un = 0 }
    }
  }
  si (T0($g, $q) == ")") { $q = $q + 1 }
  $ret = "vide|vide"
  si (T0($g, $q) == "->") {
    $rt = typex($g, $x, $q + 1)
    $ret = NOD($rt)
    $q = SEPR($rt)
  }
  $ext = "1"
  $corps = ""
  si (T0($g, $q) == "{") {
    $ext = ""
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $corps = NOD($c)
    $q = SEPR($c)
  }
  joindre($fnoms, $nom)
  joindre($fext, $ext)
  joindre($fparams, $params)
  joindre($fret, $ret)
  joindre($fcorps, $corps)
  joindre($fligne, $lf)
  retour chaine($q) + "|" + $nom
}

# ══════════════════ repli de constantes (passe 1) ══════════════════
# Miroir de replier_constants : fonctions triées (corps seulement), puis le
# niveau supérieur ; post-ordre strict (arguments, gauche, droite, nœud).
# La vue d'un nœud vaut « 1|texte|drapeau » si le nœud est (ou devient) un
# littéral après repli, « 0 » sinon. Les flottants repliés portent le texte
# exact de texte_flottant : la représentation la plus courte qui se relit à
# l'identique, « .0 » ajouté si elle n'a ni point ni exposant. flot_txt le
# reconstruit depuis chaine() — même repr, sauf entiers flottants où chaine
# tronque, et le signe du zéro se relit dans 1.0 / v.
# /0 flottant ne plie pas (miroir du nullptr) ; NaN/∞ non plus.
# Les entrées sont stockées par indice de nœud pour que la passe 2 voie
# l'arbre replié sans jamais modifier les pools.

fn entree($i: entier, $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) -> chaine {
  $n = longueur($foi)
  $j = 1
  tant_que ($j < $n) {
    si ($foi[$j] == $i) { retour "1|" + $fot[$j] + "|" + $fof[$j] }
    $j = $j + 1
  }
  retour "0"
}

fn stocker($i: entier, $t: chaine, $f: chaine,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) {
  joindre($foi, $i)
  joindre($fot, $t)
  joindre($fof, $f)
}

fn vue_texte($v: chaine) -> chaine {
  $n = longueur($v)
  si ($n < 3) { retour "" }
  si (ordre($v[$n - 1]) == 124) { retour sous_chaine($v, 2, $n - 1) }
  retour sous_chaine($v, 2, $n - 2)
}

fn vue_flag($v: chaine) -> chaine {
  $n = longueur($v)
  si ($n < 3) { retour "" }
  si (ordre($v[$n - 1]) == 124) { retour "" }
  retour sous_chaine($v, $n - 1, $n)
}

fn replier_expr($i: entier,
                $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                $lg: liste<entier>, $al: liste<entier>,
                $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                $err: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "0" }
  $kd = $k[$i]
  $va = "0"
  $vb = "0"
  si ($kd == "lst" ou $kd == "app") {
    $sa = $as[$i]
    $n = $ac[$i]
    $j = 0
    tant_que ($j < $n) {
      replier_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
      $j = $j + 1
    }
  }
  sinon si ($kd == "idx" ou $kd == "bin") {
    $ga = $a[$i]
    $gb = $b[$i]
    si ($ga >= 0) { $va = replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($gb >= 0) { $vb = replier_expr($gb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd != "bin") { retour "0" }
  }
  sinon si ($kd == "uni" ou $kd == "fac") {
    $ga = $a[$i]
    si ($ga >= 0) { $va = replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd == "fac") {
      si ($va != "0" et vue_flag($va) == "") {
        $t = vue_texte($va)
        si (non contient_barre($t)) {
          $n = entier($t)
          si ($n >= 0 et $n <= 20000) {
            $acc = 1
            $j = 2
            tant_que ($j <= $n) { $acc = $acc * $j; $j = $j + 1 }
            $r = chaine($acc)
            stocker($i, $r, "", $foi, $fot, $fof)
            retour "1|" + $r + "|"
          }
        }
      }
      retour "0"
    }
  }
  sinon si ($kd == "lit") {
    retour "1|" + $tx[$i] + "|" + $tf[$i]
  }
  sinon { retour "0" }
  si (longueur($err) > 1) { retour "0" }
  $l = $lg[$i]
  # — unaire « - » sur littéral : miroir litt_depuis_q(-q) —
  si ($kd == "uni" et $va != "0") {
    si ($tx[$i] != "-") { retour "0" }
    si (vue_flag($va) == "1") {
      $fv = val_d($va)
      $zn = faux
      si ($fv == 0.0 et non texte_neg(vue_texte($va))) { $zn = vrai }
      $rs = flot_txt(-$fv, $zn)
      stocker($i, $rs, "1", $foi, $fot, $fof)
      retour "1|" + $rs + "|1"
    }
    $t = vue_texte($va)
    $nvt = ""
    si (rnul($t)) { $nvt = "0" }
    sinon si (ordre($t[0]) == 45) { $nvt = sous_chaine($t, 1, longueur($t)) }
    sinon { $nvt = "-" + $t }
    stocker($i, $nvt, "", $foi, $fot, $fof)
    retour "1|" + $nvt + "|"
  }
  # — binaire sur deux littéraux : miroir fold_bin —
  si ($kd == "bin" et $va != "0" et $vb != "0") {
    $op = $tx[$i]
    si (vue_flag($va) == "1" ou vue_flag($vb) == "1") {
      si ($op == "+" ou $op == "-" ou $op == "*" ou $op == "/" ou $op == "^") {
        $fa = val_d($va)
        $fbv = val_d($vb)
        $plie = 1
        $rf = 0.0
        $zn = faux
        si ($op == "+") { $rf = $fa + $fbv }
        sinon si ($op == "-") { $rf = $fa - $fbv }
        sinon si ($op == "*") {
          $rf = $fa * $fbv
          si ($rf == 0.0 et texte_neg(vue_texte($va)) != texte_neg(vue_texte($vb))) { $zn = vrai }
        }
        sinon si ($op == "/") {
          si ($fbv == 0.0) { $plie = 0 }
          sinon { $rf = $fa / $fbv }
        }
        sinon { $rf = $fa ^ $fbv }
        si ($plie == 1) {
          $rs = flot_txt($rf, $zn)
          si (contient($rs, "inf") ou contient($rs, "nan")) { $plie = 0 }
          si ($plie == 1) {
            stocker($i, $rs, "1", $foi, $fot, $fof)
            retour "1|" + $rs + "|1"
          }
        }
        retour "0"
      }
      retour "0"
    }
    si ($op == "≈" ou $op == "?=" ou $op == "=~" ou $op == "==" ou $op == "!=" ou $op == "%") {
      retour "0"
    }
    $ta = vue_texte($va)
    $tb = vue_texte($vb)
    $p1 = rnum($ta)
    $q1 = rden($ta)
    $p2 = rnum($tb)
    $q2 = rden($tb)
    $r = ""
    $np = 0
    $nq = 1
    si ($op == "+") { $np = $p1 * $q2 + $p2 * $q1; $nq = $q1 * $q2 }
    sinon si ($op == "-") { $np = $p1 * $q2 - $p2 * $q1; $nq = $q1 * $q2 }
    sinon si ($op == "*") { $np = $p1 * $p2; $nq = $q1 * $q2 }
    sinon si ($op == "/") {
      si (rnul($tb)) { lever($l, "Division par zéro dans une constante", $err); retour "0" }
      $np = $p1 * $q2; $nq = $q1 * $p2
    }
    sinon si ($op == "^") {
      si ($q2 != 1) { retour "0" }
      si ($p2 < 0 et rnul($ta)) { lever($l, "0^négatif dans une constante", $err); retour "0" }
      si ($p2 > 9223372036854775807 ou 0 - $p2 > 9223372036854775807) { retour "0" }
      $num = 1
      $den = 1
      si ($p2 >= 0) { $num = rpui($p1, $p2); $den = rpui($q1, $p2) }
      sinon {
        $kk = 0 - $p2
        $num = rpui($q1, $kk)
        $den = rpui($p1, $kk)
      }
      $np = $num; $nq = $den
    }
    sinon si ($op == "div") {
      si (rnul($tb)) { lever($l, "division par zéro dans une constante", $err); retour "0" }
      $r = chaine($p1 * $q2 div ($q1 * $p2))
      stocker($i, $r, "", $foi, $fot, $fof)
      retour "1|" + $r + "|"
    }
    sinon { retour "0" }
    $r = rnorm($np, $nq)
    $fl = ""
    si (non rden1($np, $nq)) { $fl = "q" }
    stocker($i, $r, $fl, $foi, $fot, $fof)
    retour "1|" + $r + "|" + $fl
  }
  retour "0"
}

fn replier_chaine($cs: chaine,
                  $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                  $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                  $lg: liste<entier>, $al: liste<entier>,
                  $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                  $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                  $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                  $err: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

fn replier_instr($i: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                 $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                 $err: liste<chaine>) {
  si (longueur($err) > 1) { retour }
  $kd = $ik[$i]
  si ($kd == "aff" ou $kd == "expr" ou $kd == "affi") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    retour
  }
  si ($kd == "retour") {
    $e = $ie[$i]
    si ($e >= 0) {
      replier_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    }
    retour
  }
  si ($kd == "si") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    $b2 = $ib2[$i]
    si ($b2 != "") {
      replier_chaine($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    }
    retour
  }
  si ($kd == "tq") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour
  }
  si ($kd == "pour") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour
  }
  si ($kd == "bloc") {
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

# ══════════════════ vérification de types (passe 2) ══════════════════
# Miroir du vérificateur C++ : expressions rendent le type « base|elt » ;
# deux paires d'environnements vivent en parallèle — l'environnement de
# l'instruction courante et le « locals » du membre (tout corps de si/
# tant_que/pour descend dans LOCALS, jamais dans l'environnement ambiant —
# bizarrerie fidèle du moteur, dualité globales/locals mesurée en v3.14).

fn ELTT($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour sous_chaine($v, $k + 1, $n)
}

fn t_from_texte($t: chaine, $f: chaine) -> chaine {
  si ($f == "1") { retour "flottant|vide" }
  si (contient_barre($t)) { retour "rationnel|vide" }
  retour "entier|vide"
}

fn ce_raw($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
              $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "vide|vide" }
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour t_entree(vue_flag($vue)) }
  $kd = $k[$i]
  $lg0 = $lg[$i]
  si ($kd == "lit") { retour t_from_texte($tx[$i], $tf[$i]) }
  si ($kd == "ch") { retour "chaine|vide" }
  si ($kd == "bol") { retour "booleen|vide" }
  si ($kd == "v") {
    $nom = $tx[$i]
    $t = env_get($nom, $vn, $vt)
    si ($t == "") { $t = env_get($nom, $gn, $gt) }
    si ($t == "") {
      lever($lg0, "Variable '" + $nom + "' utilisée sans valeur", $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "lst") {
    $n = $ac[$i]
    $sa = $as[$i]
    si ($n == 0) {
      lever($lg0, "Liste vide : le type d'élément est introuvable", $err)
      retour "vide|vide"
    }
    $t_elt = check_expr($al[$sa], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $j = 1
    tant_que ($j < $n) {
      $tch = check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
      si ($tch != $t_elt) {
        si (estnum($tch) et estnum($t_elt)) { $t_elt = promote($tch, $t_elt) }
        sinon {
          lever($lg0, "Liste hétérogène : " + nomty($t_elt) + " puis " + nomty($tch), $err)
          retour "vide|vide"
        }
      }
      $j = $j + 1
    }
    si (longueur($err) > 1) { retour "vide|vide" }
    si (BASE($t_elt) == "liste") {
      lever($lg0, "Listes de listes non supportées pour l'instant", $err)
      retour "vide|vide"
    }
    retour "liste|" + BASE($t_elt)
  }
  si ($kd == "idx") {
    $tb = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $ti = check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $bb = BASE($tb)
    $bi = BASE($ti)
    si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "valeur") {
      lever($lg0, "Index sur un " + nomty($tb) + ", une liste est attendue", $err)
      retour "vide|vide"
    }
    si ($bb == "table" ou $bb == "valeur") {
      $cle_ok = 0
      si ($bi == "entier") { $cle_ok = 1 }
      sinon si ($bi == "rationnel") { $cle_ok = 1 }
      sinon si ($bi == "flottant") { $cle_ok = 1 }
      sinon si ($bi == "chaine") { $cle_ok = 1 }
      sinon si ($bi == "booleen") { $cle_ok = 1 }
      si ($bb == "table" et $cle_ok == 0) {
        lever($lg0, "Index d'une table doit être un texte ou un nombre", $err)
        retour "vide|vide"
      }
      retour "valeur|vide"
    }
    si ($bi != "entier") {
      $msg = "Index d'une liste doit être entier"
      si ($bb == "chaine") { $msg = "Index d'une chaîne doit être entier" }
      lever($lg0, $msg, $err)
      retour "vide|vide"
    }
    si ($bb == "chaine") { retour "chaine|vide" }
    retour ELTT($tb) + "|vide"
  }
  si ($kd == "uni") {
    $t = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si ($tx[$i] == "non") {
      si (BASE($t) != "booleen") {
        lever($lg0, "La condition de non doit être booléenne, trouvé " + nomty($t), $err)
        retour "vide|vide"
      }
      retour "booleen|vide"
    }
    si (non estnum($t)) {
      lever($lg0, "Unaire " + $tx[$i] + " sur un " + nomty($t), $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "fac") {
    $t = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "entier") {
      lever($lg0, "Factorielle attend un entier, trouvé " + nomty($t), $err)
      retour "vide|vide"
    }
    retour "entier|vide"
  }
  si ($kd == "bin") { retour check_bin($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                        $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt) }
  si ($kd == "app") { retour check_appel($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                          $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                          $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt) }
  lever($lg0, "Expression inconnue", $err)
  retour "vide|vide"
}

fn check_bin($i: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
             $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $op = $tx[$i]
  $lg0 = $lg[$i]
  $tg = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  $td = check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  si (longueur($err) > 1) { retour "vide|vide" }
  si ($op == "et" ou $op == "ou") {
    si (BASE($tg) != "booleen") {
      lever($lg0, "La condition de et/ou doit être booléenne, trouvé " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (BASE($td) != "booleen") {
      lever($lg0, "La condition de et/ou doit être booléenne, trouvé " + nomty($td), $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "==" ou $op == "!=" ou $op == "≈" ou $op == "?=" ou $op == "=~") {
    si ($tg != $td et non(estnum($tg) et estnum($td))) {
      lever($lg0, "Comparaison " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "<" ou $op == "<=" ou $op == ">" ou $op == ">=") {
    $okordre = 0
    si (estnum($tg) et estnum($td)) { $okordre = 1 }
    si (BASE($tg) == "chaine" et BASE($td) == "chaine") { $okordre = 1 }
    si ($okordre == 0) {
      lever($lg0, "Ordre " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "+") {
    si (BASE($tg) == "chaine" et BASE($td) == "chaine") { retour "chaine|vide" }
    si (estnum($tg) et estnum($td)) { retour promote($tg, $td) }
    lever($lg0, "Addition " + nomty($tg) + " + " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "-" ou $op == "*") {
    si (estnum($tg) et estnum($td)) { retour promote($tg, $td) }
    lever($lg0, "Opération " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "/") {
    si (estnum($tg) et estnum($td)) {
      $r = promote($tg, $td)
      si (BASE($r) == "entier") { retour "rationnel|vide" }
      retour $r
    }
    lever($lg0, "Division " + nomty($tg) + " / " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "%") {
    si (BASE($tg) == "entier" et BASE($td) == "entier") { retour "entier|vide" }
    lever($lg0, "Le modulo exige deux entiers", $err)
    retour "vide|vide"
  }
  si ($op == "div") {
    si (non(estnum($tg) ou BASE($tg) == "booleen")) {
      lever($lg0, "div attend un nombre à gauche, trouvé " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (non(estnum($td) ou BASE($td) == "booleen")) {
      lever($lg0, "div attend un nombre à droite, trouvé " + nomty($td), $err)
      retour "vide|vide"
    }
    si (BASE($tg) == "flottant" ou BASE($td) == "flottant") { retour "flottant|vide" }
    retour "entier|vide"
  }
  si ($op == "^") {
    si (non estnum($tg)) {
      lever($lg0, "Puissance sur une base " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (BASE($td) == "flottant") { retour "flottant|vide" }
    $bd = BASE($td)
    si ($bd == "entier" ou $bd == "rationnel" ou $bd == "booleen") {
      $gb = $b[$i]
      $est_uni = 1
      si (entree($gb, $foi, $fot, $fof) != "0") { $est_uni = 0 }
      sinon si ($k[$gb] != "uni") { $est_uni = 0 }
      sinon si ($tx[$gb] != "-") { $est_uni = 0 }
      si ($est_uni == 1) {
        si (BASE($tg) == "entier") { retour "rationnel|vide" }
        retour $tg
      }
      si (BASE($tg) == "entier") { retour "entier|vide" }
      retour $tg
    }
    lever($lg0, "Exposant " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  lever($lg0, "Opérateur '" + $op + "' inconnu", $err)
  retour "vide|vide"
}

# — tables STDLIB et DYNAMIQUE (miroir exact des 45 + 4 entrées) —
# Format « retour|codes,virgules ». Codes inconnus du vérificateur C++
# (« n », « table ») acceptent tout : ils restent ici sans règle, fidèles.

fn std_sig($nom: chaine) -> chaine {
  si ($nom == "afficher") { retour "vide|n" }
  si ($nom == "saisir_entier") { retour "entier|" }
  si ($nom == "saisir_flottant") { retour "flottant|" }
  si ($nom == "factorielle") { retour "entier|entier" }
  si ($nom == "fibonacci") { retour "entier|entier" }
  si ($nom == "pgcd") { retour "entier|entier,entier" }
  si ($nom == "ppcm") { retour "entier|entier,entier" }
  si ($nom == "puissance") { retour "entier|num,entier" }
  si ($nom == "est_premier") { retour "booleen|entier" }
  si ($nom == "compter_premiers") { retour "entier|entier" }
  si ($nom == "nb_chiffres") { retour "entier|entier" }
  si ($nom == "nombre_pi") { retour "chaine|entier" }
  si ($nom == "longueur") { retour "entier|lct" }
  si ($nom == "table") { retour "table|" }
  si ($nom == "inserer") { retour "vide|table,tout,tout" }
  si ($nom == "cle_existe") { retour "booleen|table,tout" }
  si ($nom == "supprimer") { retour "booleen|table,tout" }
  si ($nom == "cles") { retour "MIXTE|table" }
  si ($nom == "valeurs") { retour "MIXTE|table" }
  si ($nom == "joindre") { retour "vide|liste,liste_elt" }
  si ($nom == "ordre") { retour "entier|chaine" }
  si ($nom == "caractere") { retour "chaine|entier" }
  si ($nom == "sous_chaine") { retour "chaine|chaine,entier,entier" }
  si ($nom == "concatener") { retour "chaine|liste" }
  si ($nom == "lire_texte") { retour "chaine|chaine" }
  si ($nom == "ecrire_texte") { retour "vide|chaine,chaine" }
  si ($nom == "nb_arguments") { retour "entier|" }
  si ($nom == "argument") { retour "chaine|entier" }
  si ($nom == "temps") { retour "entier|" }
  si ($nom == "duree") { retour "chaine|entier" }
  si ($nom == "afficher_erreur") { retour "vide|tout" }
  si ($nom == "quitter") { retour "vide|entier" }
  si ($nom == "abs") { retour "MIXTE|num" }
  si ($nom == "min") { retour "NUM_MAX|num,num" }
  si ($nom == "max") { retour "NUM_MAX|num,num" }
  si ($nom == "partie_entiere") { retour "entier|num" }
  si ($nom == "fraction") { retour "rationnel|entier,entier" }
  si ($nom == "graine") { retour "vide|entier" }
  si ($nom == "hasard") { retour "entier|entier" }
  si ($nom == "tampon") { retour "tampon|entier" }
  si ($nom == "octets") { retour "tampon|chaine" }
  si ($nom == "tampon_case") { retour "entier|tampon,entier" }
  si ($nom == "tampon_pose") { retour "vide|tampon,entier,entier" }
  si ($nom == "remplir_hasard") { retour "vide|tampon,tampon" }
  si ($nom == "millisecondes") { retour "entier|" }
  retour ""
}

fn dyn_sig($nom: chaine) -> chaine {
  si ($nom == "charger") { retour "entier|chaine" }
  si ($nom == "fermer") { retour "vide|entier" }
  si ($nom == "appeler0") { retour "flottant|entier,chaine" }
  si ($nom == "appeler1") { retour "flottant|entier,chaine,num" }
  si ($nom == "appeler2") { retour "flottant|entier,chaine,num,num" }
  retour ""
}

fn vargs($i: entier, $codes: chaine, $nom: chaine,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>,
         $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
         $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
         $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
         $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
         $tri: liste<entier>, $trt: liste<chaine>) {
  $nargs = $ac[$i]
  $np = nb_pieces($codes, 44)
  si ($nargs != $np) {
    lever($lg[$i], $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($nargs), $err)
    retour
  }
  $sa = $as[$i]
  $t_elt = "vide|vide"
  $a_elt = 0
  $j = 0
  tant_que ($j < $nargs) {
    $ta = check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $code = piece($codes, 44, $j + 1)
    si ($code == "chaine") {
      si (BASE($ta) != "chaine") { lever($lg[$i], $nom + ": une chaine est attendue", $err) }
    }
    sinon si ($code == "num") {
      si (non estnum($ta)) {
        lever($lg[$i], $nom + ": un nombre est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "entier") {
      si (BASE($ta) != "entier") {
        lever($lg[$i], $nom + ": un entier est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "liste") {
      si (BASE($ta) != "liste") {
        lever($lg[$i], $nom + ": une liste est attendue, reçu " + nomty($ta), $err)
      }
      $t_elt = tyb(ELTT($ta))
      $a_elt = 1
    }
    sinon si ($code == "tampon") {
      si (BASE($ta) != "tampon") {
        lever($lg[$i], $nom + ": un tampon est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "lct") {
      $bb = BASE($ta)
      si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "tampon") {
        lever($lg[$i], $nom + ": une liste, une chaîne ou une table est attendue, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "liste_elt") {
      $tolere = 0
      si ($a_elt == 1 et BASE($t_elt) != "vide" et $ta != $t_elt) {
        si (estnum($ta) et estnum($t_elt) et promote($ta, $t_elt) == $t_elt) { $tolere = 1 }
        si ($tolere == 0) {
          lever($lg[$i], $nom + ": élément " + nomty($ta) + " ne correspond pas à la liste " + nomty($t_elt), $err)
        }
      }
    }
    $j = $j + 1
  }
}

fn check_appel($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $lg0 = $lg[$i]
  $tx0 = $tx[$i]
  $mod = eclate_mod($tx0)
  $nom = eclate_nom($tx0)
  # — dynamique:: —
  si ($mod == "dynamique") {
    $spec = dyn_sig($nom)
    si ($spec == "") {
      lever($lg0, "Fonction dynamique::" + $nom + " inconnue (disponibles: charger, fermer, appeler0, appeler1, appeler2)", $err)
      retour "vide|vide"
    }
    vargs($i, piece($spec, 124, 2), "dynamique::" + $nom,
          $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
          $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour tyb(piece($spec, 124, 1))
  }
  # — conversions d'un argument, avant les signatures —
  $cast = 0
  si ($nom == "entier") { $cast = 1 }
  sinon si ($nom == "rationnel") { $cast = 1 }
  sinon si ($nom == "flottant") { $cast = 1 }
  sinon si ($nom == "chaine") { $cast = 1 }
  si ($cast == 1 et $ac[$i] == 1) {
    $t = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si ($nom == "chaine") { retour "chaine|vide" }
    si (BASE($t) == "chaine") {
      si ($nom == "entier") { retour "entier|vide" }
      si ($nom == "flottant") { retour "flottant|vide" }
      lever($lg0, "Conversion chaine → rationnel non disponible, passez par flottant", $err)
      retour "vide|vide"
    }
    si (non estnum($t)) {
      lever($lg0, "Conversion " + nomty($t) + " → " + nomty(tyb($nom)) + " impossible", $err)
      retour "vide|vide"
    }
    retour tyb($nom)
  }
  # — fonctions de l'utilisateur (externes comprises) —
  $pos = 0
  $u = 1
  $nf = longueur($fnoms)
  tant_que ($u < $nf) {
    si ($pos == 0 et $fnoms[$u] == $nom) { $pos = $u }
    $u = $u + 1
  }
  si ($pos > 0) {
    $ps = $fparams[$pos]
    $np = nb_pieces($ps, 59)
    si ($ac[$i] != $np) {
      lever($lg0, $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($ac[$i]), $err)
      retour "vide|vide"
    }
    $sa = $as[$i]
    $j = 1
    $ok = 1
    tant_que ($j <= $np) {
      si ($ok == 1) {
        $ta = check_expr($al[$sa + $j - 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                         $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
        $ent = piece($ps, 59, $j)
        $t_att = sous_chaine($ent, premier_pipe($ent) + 1, longueur($ent))
        $bad = 0
        si ($ta != $t_att) {
          si (non(estnum($ta) et estnum($t_att) et promote($ta, $t_att) == $t_att)) { $bad = 1 }
        }
        si ($bad == 1) {
          lever($lg0, "Argument de " + $nom + ": " + nomty($ta) + " reçu, " + nomty($t_att) + " attendu", $err)
          $ok = 0
        }
      }
      $j = $j + 1
    }
    retour $fret[$pos]
  }
  # — bibliothèque standard —
  $spec = std_sig($nom)
  si ($spec == "") {
    lever($lg0, "Fonction '" + $nom + "' inconnue", $err)
    retour "vide|vide"
  }
  vargs($i, piece($spec, 124, 2), $nom,
        $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
        $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  si (longueur($err) > 1) { retour "vide|vide" }
  $ret = piece($spec, 124, 1)
  si ($ret == "MIXTE") {
    $t = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "booleen") { retour "entier|vide" }
    retour $t
  }
  si ($ret == "NUM_MAX") {
    $ta1 = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $ta2 = check_expr($al[$as[$i] + 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour promote($ta1, $ta2)
  }
  retour tyb($ret)
}

fn premier_pipe($v: chaine) -> entier {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour $k
}

# ══════════════════ instructions vérifiées ══════════════════

fn check_instr($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $ln: liste<chaine>, $lt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $ass: entier, $ra: chaine, $err: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) {
  si (longueur($err) > 1) { retour }
  $kd = $ik[$i]
  $lg0 = $ilg[$i]
  si ($kd == "aff") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "vide") { lever($lg0, "Rien à afficher ici", $err) }
    retour
  }
  si ($kd == "lire") {
    $nom = $ino[$i]
    $t = env_get($nom, $vn, $vt)
    si ($t == "") {
      reserver($nom, $lg0, $err)
      env_put($nom, "entier|vide", $vn, $vt)
      si (longueur($err) == 1) { joindre($tri, $i); joindre($trt, "1") }
    }
    sinon {
      $bb = BASE($t)
      si ($bb != "entier" et $bb != "flottant" et $bb != "rationnel") {
        lever($lg0, "Ne peut pas lire dans une variable " + nomty($t) + " (entier/flottant attendus)", $err)
      }
      sinon {
        $nu = "1"
        si ($bb == "rationnel") { $nu = "2" }
        sinon si ($bb == "flottant") { $nu = "3" }
        joindre($tri, $i)
        joindre($trt, $nu)
      }
    }
    retour
  }
  si ($kd == "affi") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "vide") {
      lever($lg0, "Impossible d'affecter une valeur sans type", $err)
      retour
    }
    $nom = $ino[$i]
    $ex = env_get($nom, $vn, $vt)
    si ($ex == "") { $ex = env_get($nom, $gn, $gt) }
    $cible = $t
    si ($ex != "") {
      $cible = $ex
      $be = BASE($ex)
      $bt = BASE($t)
      $domaine_ok = 1
      si ($be == "valeur" ou $bt == "valeur") { $domaine_ok = 1 }
      sinon si ($bt == "entier" et $be == "rationnel") { $domaine_ok = 1 }
      sinon si ($t != $ex) {
        $domaine_ok = 0
        si (promote($t, $ex) == $ex et estnum($t) et estnum($ex)) { $domaine_ok = 1 }
        si ($domaine_ok == 0) {
          lever($lg0, "'" + $nom + "' est " + nomty($ex) + ", on ne peut pas y stocker du " + nomty($t), $err)
          retour
        }
      }
    }
    reserver($nom, $lg0, $err)
    env_put($nom, $cible, $vn, $vt)
    retour
  }
  si ($kd == "si") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "booleen") {
      lever($lg0, "La condition de si doit être booléenne, trouvé " + nomty($t), $err)
      retour
    }
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    $b2 = $ib2[$i]
    si ($b2 != "" et longueur($err) == 1) {
      parcourir($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    }
    retour
  }
  si ($kd == "tq") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "booleen") {
      lever($lg0, "La condition de tant_que doit être booléenne, trouvé " + nomty($t), $err)
      retour
    }
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    retour
  }
  si ($kd == "pour") {
    $nom = $ino[$i]
    si (env_get($nom, $vn, $vt) != "") {
      lever($lg0, "La variable de boucle '" + $nom + "' existe déjà", $err)
      retour
    }
    $td = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $tfin = check_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                       $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($td) != "entier" ou BASE($tfin) != "entier") {
      lever($lg0, "pour…de…vers exige des bornes entières", $err)
      retour
    }
    reserver($nom, $lg0, $err)
    env_put($nom, "entier|vide", $vn, $vt)
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    retour
  }
  si ($kd == "retour") {
    si ($ass == 0) {
      lever($lg0, "'retour' hors de fonction", $err)
      retour
    }
    $e = $ie[$i]
    si ($e < 0) {
      si ($ra != "vide|vide") {
        lever($lg0, "La fonction doit retourner un " + nomty($ra), $err)
      }
    }
    sinon {
      $t = check_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
      $bad = 0
      si ($t != $ra) {
        si (non(estnum($t) et estnum($ra) et promote($t, $ra) == $ra)) { $bad = 1 }
      }
      si ($bad == 1) {
        lever($lg0, "La fonction retourne " + nomty($t) + ", attendu " + nomty($ra), $err)
      }
    }
    retour
  }
  si ($kd == "expr") {
    check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour
  }
  si ($kd == "bloc") {
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
  }
}

fn parcourir($cs: chaine,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $ln: liste<chaine>, $lt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $ass: entier, $ra: chaine, $err: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                      $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                      $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
  }
}

# comparution lexicale par codepoints = ordre std::map du moteur
fn cmp_str($a: chaine, $b: chaine) -> entier {
  $la = longueur($a)
  $lb = longueur($b)
  $n = $la
  si ($lb < $n) { $n = $lb }
  $i = 0
  tant_que ($i < $n) {
    $ca = ordre($a[$i])
    $cb = ordre($b[$i])
    si ($ca < $cb) { retour -1 }
    si ($ca > $cb) { retour 1 }
    $i = $i + 1
  }
  si ($la < $lb) { retour -1 }
  si ($la > $lb) { retour 1 }
  retour 0
}

# ══════════════════ notes de types et coque de vérification ══════════════════
# L'émission RIR a besoin du type que le vérificateur a calculé pour chaque
# nœud (suffixes add.f, cst.q, destination de index…) et du type de lecture
# de chaque « lire » (message du dump). check_expr est la COQUE de ce_raw :
# elle note le type (index du nœud vers « base|elt ») à chaque visite saine
# puis le rend. Les secondes visites (MIXTE/NUM_MAX recalent l'argument)
# recréent des entrées identiques : la recherche lit la première, le doublon
# est inoffensif. Les notes voyagent en listes plates — une table en
# paramètre serait hors de portée de l'AOT — et l'ordre post-ordre des deux
# passes rend la recherche linéaire quasi immédiate.

fn check_expr($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
              $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $t = ce_raw($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err,
              $tni, $tnt, $tri, $trt)
  si (longueur($err) == 1) {
    joindre($tni, $i)
    joindre($tnt, $t)
  }
  retour $t
}

# type d'une entrée de repli d'après son drapeau : « 1 » flottant, « q »
# rationnel, vide entier — sans jamais ratisser le texte (un pli comme
# 2^30000000 fait neuf millions de caractères que contient_barre ne doit
# pas parcourir, et le drapeau porte déjà l'information, comme le nœud
# littéral reconstitué côté C++ : T_ENTIER / T_RATIONNEL / T_FLOTTANT).
fn t_entree($f: chaine) -> chaine {
  si ($f == "1") { retour "flottant|vide" }
  si ($f == "q") { retour "rationnel|vide" }
  retour "entier|vide"
}

# dénominateur réduit à 1 ? — miroir fidèle de la normalisation de rnorm,
# calculé sur les entiers (le pgcd d'un géant et de 1 est un seul modulo).
fn rden1($p: entier, $q: entier) -> booleen {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour vrai }
  $g = pgcd2($np, $nq)
  si ($g > 1) { $nq = $nq div $g }
  retour $nq == 1
}

fn contient($s: chaine, $d: chaine) -> booleen {
  $n = longueur($s)
  $m = longueur($d)
  si ($m == 0) { retour vrai }
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $d) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

# texte de littéral -> double au sens de lit_valeur_d : « p/q » vaut p divisé
# par q (le moteur fait strtod puis division), le reste passe par flottant(),
# le strtod du moteur — arrondi au plus proche identique.
fn val_d($v: chaine) -> flottant {
  $t = vue_texte($v)
  $n = longueur($t)
  $j = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($j >= $n) { $ok = 0 }
    sinon si (ordre($t[$j]) == 47) { $ok = 0 }
    sinon { $j = $j + 1 }
  }
  si ($j >= $n) { retour flottant($t) }
  retour flottant(sous_chaine($t, 0, $j)) / flottant(sous_chaine($t, $j + 1, $n))
}

# texte que le moteur écrit dans le RIR pour un flottant replié :
# texte_flottant = représentation la plus courte qui se relit à l'identique,
# « .0 » ajouté si elle n'a ni point ni exposant. chaine() imite ce texte
# SAUF pour les flottants entiers (|v| < 1e16) où il tronque via %lld :
# « 5.0 » devient « 5 » et « -0.0 » devient « 0 », signe perdu. On recolle
# donc « .0 » dans ce cas ; le signe du zéro se calcule sur place dans le
# pli (négation qui écrase un zéro, produit de facteurs de signes
# contraires) et se fige dans le texte stocké — 1.0 / 0.0 lève « division
# par zéro » dans le moteur, aucun sondage n'est possible, et les fonctions
# ne voyant pas les globales, rien d'autre ne peut charrier ce signe.
fn flot_txt($v: flottant, $zneg: booleen) -> chaine {
  $rs = chaine($v)
  $af = $v
  si ($af < 0.0) { $af = -$af }
  si ($af < 10000000000000000.0) {
    si ($v == entier($v)) {
      si ($v == 0.0) {
        $rs = "0.0"
        si ($zneg) { $rs = "-0.0" }
      }
      sinon {
        # flottant entier : chaine() passe par %lld — il faut le %.Ng de
        # texte_flottant. Chiffres significatifs = digits sans les zéros
        # finaux ; exposant = longueur - 1. printf : style fixe si
        # exposant < chiffres, sinon scientifique « d.ddde±dd ».
        $dg = chaine(entier($af))
        $e = longueur($dg) - 1
        $m = $dg
        $ok = 1
        tant_que ($ok == 1) {
          $nn = longueur($m)
          si ($nn <= 1) { $ok = 0 }
          sinon si (ordre($m[$nn - 1]) == 48) { $m = sous_chaine($m, 0, $nn - 1) }
          sinon { $ok = 0 }
        }
        $p = longueur($m)
        si ($e < $p) {
          $rs = $dg + ".0"
        } sinon {
          $rs = sous_chaine($m, 0, 1)
          si ($p > 1) { $rs = $rs + "." + sous_chaine($m, 1, $p) }
          $rs = $rs + "e+"
          si ($e < 10) { $rs = $rs + "0" }
          $rs = $rs + chaine($e)
        }
        si ($v < 0.0) { $rs = "-" + $rs }
      }
    }
  }
  retour $rs
}

# le signe d'un texte de littéral (les opérandes d'un pli sont toujours des
# littéraux — le « -0.0 » déjà plié porte son moins).
fn texte_neg($t: chaine) -> booleen {
  si (longueur($t) == 0) { retour faux }
  retour ordre($t[0]) == 45
}

# ══════════════════ émission RIR (passe 3) ══════════════════
# Miroir d'EmetteurRir : compteurs partagés — %t et suffixes de bloc comptent
# sans reprise sur tout le module. Les blocs sont déclarés dans l'ordre des
# push_back C++ ; le bloc en attente (test de tant_que, borne de pour) reçoit
# ses lignes avant même d'être listé, en portant déjà son nom : la liste $fb
# garde l'ordre de création et la fenêtre de lignes d'un bloc reste contiguë.
# Le curseur est toujours le dernier bloc déclaré — la coupure des « si »
# imbriqués tombe donc dans le « fin » intérieur, comme dans le moteur.

fn rir_of($b: chaine) -> chaine {
  si ($b == "entier") { retour "z" }
  si ($b == "rationnel") { retour "q" }
  si ($b == "flottant") { retour "f" }
  si ($b == "booleen") { retour "b" }
  si ($b == "chaine") { retour "s" }
  si ($b == "liste") { retour "l" }
  si ($b == "table") { retour "tbl" }
  retour "u"
}

fn tick_t($tc: liste<entier>) -> chaine {
  $s = "%t" + chaine(longueur($tc) - 1)
  joindre($tc, 0)
  retour $s
}

fn tick_b($bc: liste<entier>) -> chaine {
  $s = "_" + chaine(longueur($bc) - 1)
  joindre($bc, 0)
  retour $s
}

# type annoté d'un nœud : note de première visite, entrée de repli (littéral
# reconstitué du monde C++), littéral de source, puis le vide.
fn own($i: entier, $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
       $tni: liste<entier>, $tnt: liste<chaine>) -> chaine {
  $n = longueur($tni)
  $j = 1
  tant_que ($j < $n) {
    si ($tni[$j] == $i) { retour $tnt[$j] }
    $j = $j + 1
  }
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour t_entree(vue_flag($vue)) }
  si ($k[$i] == "lit") { retour t_from_texte($tx[$i], $tf[$i]) }
  retour "vide|vide"
}

fn e_bloc($fb: liste<chaine>, $cc: liste<entier>, $nom: chaine) {
  joindre($fb, $nom)
  joindre($cc, longueur($fb) - 1)
}

# $na : la ligne a un opérande — le dump C++ écrit « » + texte pour chaque
# opérande, même vide (une chaine vide se dump «cst.s » avec l'espace).
fn e_ligne($fl: liste<chaine>, $flb: liste<entier>, $fp: liste<chaine>, $cc: liste<entier>,
           $dest: chaine, $op: chaine, $argstr: chaine, $msg: chaine, $na: booleen) {
  $l = "  "
  si ($dest != "") { $l = $l + $dest + " = " }
  $l = $l + $op
  si ($na) { $l = $l + " " + $argstr }
  si ($msg != "") { $l = $l + " \"" + $msg + "\"" }
  joindre($fl, $l)
  joindre($flb, $cc[longueur($cc) - 1])
  joindre($fp, $op)
}

fn em_expr($i: entier, $ta: chaine,
           $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
           $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
           $lg: liste<entier>, $al: liste<entier>,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
           $tni: liste<entier>, $tnt: liste<chaine>,
           $tc: liste<entier>, $bc: liste<entier>,
           $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
           $fp: liste<chaine>, $cc: liste<entier>) -> chaine {
  $ty = own($i, $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
  si ($ta == "u" et BASE($ty) != "vide") { $ta = rir_of(BASE($ty)) }
  $kd = $k[$i]
  $op0 = $tx[$i]
  $t = ""
  $g = ""
  $d = ""
  $opn = ""
  # — comparaison entre tampons : égalité générique, pas de conversion —
  si ($kd == "bin" et ($op0 == "==" ou $op0 == "!=")) {
    $tg = own($a[$i], $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
    $td = own($b[$i], $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
    si (BASE($tg) == "tampon" ou BASE($td) == "tampon") {
      $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      $d = em_expr($b[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      $t = tick_t($tc)
      $opn = "cmp.eq.b"
      si ($op0 == "!=") { $opn = "cmp.ne.b" }
      e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g + " " + $d, "", vrai)
      retour $t
    }
  }
  # — nœud replié = littéral du monde C++ : constante inline —
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst." + $ta, "@" + "c" + vue_texte($vue), "", vrai)
    retour $t
  }
  si ($kd == "lit") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst." + $ta, "@" + "c" + $tx[$i], "", vrai)
    retour $t
  }
  si ($kd == "ch") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst.s", $tx[$i], "", vrai)
    retour $t
  }
  si ($kd == "bol") {
    $t = tick_t($tc)
    $vv = "faux"
    si ($tx[$i] == "1") { $vv = "vrai" }
    e_ligne($fl, $flb, $fp, $cc, $t, "cst.b", $vv, "", vrai)
    retour $t
  }
  si ($kd == "v") { retour "%" + $tx[$i] }
  si ($kd == "idx") {
    $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $d = em_expr($b[$i], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "index", $g + " " + $d, "", vrai)
    retour $t
  }
  si ($kd == "bin") {
    $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $d = em_expr($b[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    si ($op0 == "+") { $opn = "add" }
    sinon si ($op0 == "-") { $opn = "sub" }
    sinon si ($op0 == "*") { $opn = "mul" }
    sinon si ($op0 == "/") { $opn = "div" }
    sinon si ($op0 == "div") { $opn = "divf" }
    sinon si ($op0 == "^") { $opn = "pow" }
    sinon si ($op0 == "%") { $opn = "rem.z" }
    sinon si ($op0 == "==") { $opn = "cmp.eq" }
    sinon si ($op0 == "!=") { $opn = "cmp.ne" }
    sinon si ($op0 == "<") { $opn = "cmp.lt" }
    sinon si ($op0 == "<=") { $opn = "cmp.le" }
    sinon si ($op0 == ">") { $opn = "cmp.gt" }
    sinon si ($op0 == ">=") { $opn = "cmp.ge" }
    sinon si ($op0 == "et") { $opn = "and" }
    sinon si ($op0 == "ou") { $opn = "or" }
    sinon { $opn = $op0 }
    si ($op0 == "≈" ou $op0 == "?=" ou $op0 == "=~") { $opn = "cmp.approx" }
    si ($opn != "cmp.approx") { $opn = $opn + "." + $ta }
    e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g + " " + $d, "", vrai)
    retour $t
  }
  si ($kd == "uni") {
    $g = em_expr($a[$i], $ta, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    $opn = "neg." + $ta
    si ($tx[$i] == "non") { $opn = "not.b" }
    e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g, "", vrai)
    retour $t
  }
  si ($kd == "fac") {
    $g = em_expr($a[$i], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "call @builtin.factorielle", $g, "", vrai)
    retour $t
  }
  si ($kd == "lst") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "liste.new", "", "", faux)
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $d = em_expr($al[$sa + $j], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      e_ligne($fl, $flb, $fp, $cc, "", "liste.push", $t + " " + $d, "", vrai)
      $j = $j + 1
    }
    retour $t
  }
  si ($kd == "app") {
    $sa = $as[$i]
    $nb = $ac[$i]
    $args = ""
    $j = 0
    tant_que ($j < $nb) {
      $d = em_expr($al[$sa + $j], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      si ($args == "") { $args = $d } sinon { $args = $args + " " + $d }
      $j = $j + 1
    }
    $t = tick_t($tc)
    $nom = $tx[$i]
    $nq = longueur($nom)
    $q = 0
    $okq = 1
    tant_que ($okq == 1) {
      si ($q >= $nq) { $okq = 0 }
      sinon si (ordre($nom[$q]) == 59) { $okq = 0 }
      sinon { $q = $q + 1 }
    }
    si ($q < $nq) { $nom = sous_chaine($nom, $q + 1, $nq) }
    $asg = "$" + $nom
    si ($args != "") { $asg = $asg + " " + $args }
    e_ligne($fl, $flb, $fp, $cc, $t, "call", $asg, "", vrai)
    retour $t
  }
  retour "%?"
}

fn em_instr($ix: entier,
            $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
            $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
            $lg: liste<entier>, $al: liste<entier>,
            $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
            $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
            $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
            $tni: liste<entier>, $tnt: liste<chaine>,
            $tri: liste<entier>, $trt: liste<chaine>,
            $tc: liste<entier>, $bc: liste<entier>,
            $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
            $fp: liste<chaine>, $cc: liste<entier>) {
  $kd = $ik[$ix]
  $lgn = $ilg[$ix]
  $v = ""
  $sf = ""
  si ($kd == "aff") {
    $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "afficher", $v, "", vrai)
    retour
  }
  si ($kd == "lire") {
    $t = tick_t($tc)
    $nu = "1"
    $nn = longueur($tri)
    $j = 1
    $trouve = 0
    tant_que ($j < $nn et $trouve == 0) {
      si ($tri[$j] == $ix) { $nu = $trt[$j]; $trouve = 1 }
      $j = $j + 1
    }
    e_ligne($fl, $flb, $fp, $cc, $t, "lire", "%" + $ino[$ix], $nu, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $t, $ino[$ix], vrai)
    retour
  }
  si ($kd == "affi") {
    $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $v, $ino[$ix], vrai)
    retour
  }
  si ($kd == "si") {
    $v = em_expr($ie[$ix], "b", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $sf = tick_b($bc)
    $l1 = ".alors_" + chaine($lgn) + $sf
    $l2 = ".sinon_" + chaine($lgn) + $sf
    $l3 = ".fin_" + chaine($lgn) + $sf
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $v + " " + $l1 + " " + $l2, "", vrai)
    e_bloc($fb, $cc, $l1)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l2)
    si ($ib2[$ix] != "") {
      em_corps($ib2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    }
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l3)
    retour
  }
  si ($kd == "tq") {
    $sf = tick_b($bc)
    $l1 = ".cond_" + chaine($lgn) + $sf
    $l2 = ".corps_" + chaine($lgn) + $sf
    $l3 = ".fin_" + chaine($lgn) + $sf
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l1)
    $v = em_expr($ie[$ix], "b", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $v + " " + $l2 + " " + $l3, "", vrai)
    e_bloc($fb, $cc, $l2)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l3)
    retour
  }
  si ($kd == "pour") {
    $var = $ino[$ix]
    $sf = tick_b($bc)
    $l1 = ".cond_" + chaine($lgn) + $sf
    $l2 = ".corps_" + chaine($lgn) + $sf
    $l3 = ".incr_" + chaine($lgn) + $sf
    $l4 = ".fin_" + chaine($lgn) + $sf
    $v = em_expr($ie[$ix], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $v, $var, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l1)
    $d = em_expr($ie2[$ix], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $ct = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $ct, "cmp.lt.z", "%" + $var + " " + $d, "", vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $ct + " " + $l2 + " " + $l4, "", vrai)
    e_bloc($fb, $cc, $l2)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l3)
    $nt = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $nt, "add.z", "%" + $var + " @c1", "", vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $nt, $var, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l4)
    retour
  }
  si ($kd == "retour") {
    si ($ie[$ix] >= 0) {
      $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      e_ligne($fl, $flb, $fp, $cc, "", "ret", $v, "", vrai)
    }
    sinon {
      e_ligne($fl, $flb, $fp, $cc, "", "ret.u", "", "", faux)
    }
    retour
  }
  si ($kd == "expr") {
    em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    retour
  }
  si ($kd == "bloc") {
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  }
}

fn em_corps($cs: chaine,
            $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
            $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
            $lg: liste<entier>, $al: liste<entier>,
            $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
            $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
            $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
            $tni: liste<entier>, $tnt: liste<chaine>,
            $tri: liste<entier>, $trt: liste<chaine>,
            $tc: liste<entier>, $bc: liste<entier>,
            $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
            $fp: liste<chaine>, $cc: liste<entier>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    $c = ordre($cs[$j])
    si ($c == 44) {
      si ($cur != "") {
        em_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
        $cur = ""
      }
    }
    sinon { $cur = $cur + $cs[$j] }
    $j = $j + 1
  }
  si ($cur != "") {
    em_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  }
}

fn em_fonction($nom: chaine, $ps: chaine, $ra: chaine, $corps: chaine,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>,
               $tc: liste<entier>, $bc: liste<entier>,
               $outl: liste<chaine>) {
  $fb = [""]
  $fl = [""]
  $flb = [0]
  $fp = [""]
  $cc = [0]
  e_bloc($fb, $cc, ".entree")
  em_corps($corps, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  # — ret. implicite quand la dernière ligne n'est pas un retour —
  $ret_ok = 0
  si (longueur($fp) > 1) {
    $pop = $fp[longueur($fp) - 1]
    si (longueur($pop) >= 3) {
      si (sous_chaine($pop, 0, 3) == "ret") { $ret_ok = 1 }
    }
  }
  si ($ret_ok == 0) { e_ligne($fl, $flb, $fp, $cc, "", "ret.u", "", "", faux) }
  # — assemblage : en-tête (paramètres sous la forme étonnante du dump,
  # nom %nom : type), puis chaque bloc avec sa fenêtre de lignes —
  joindre($outl, "")
  $tt = "fonction " + $nom + "("
  $np = nb_pieces($ps, 59)
  $u = 1
  tant_que ($u <= $np) {
    si ($u > 1) { $tt = $tt + ", " }
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    $pt = sous_chaine($ent, $pp + 1, longueur($ent))
    $tt = $tt + $pn + " %" + $pn + " : " + rir_of(BASE($pt))
    $u = $u + 1
  }
  $tt = $tt + ") -> " + rir_of(BASE($ra)) + " {"
  joindre($outl, $tt)
  $ln = 1
  $bk = 1
  tant_que ($bk < longueur($fb)) {
    joindre($outl, $fb[$bk] + ":")
    $arret = 0
    tant_que ($ln < longueur($fl) et $arret == 0) {
      si ($flb[$ln] != $bk) { $arret = 1 }
      sinon {
        joindre($outl, $fl[$ln])
        $ln = $ln + 1
      }
    }
    $bk = $bk + 1
  }
  joindre($outl, "}")
}

# ══════════════════ programme principal ══════════════════

$src = ""
si (nb_arguments() > 0) { $src = lire_texte(argument(0)) }
$N = longueur($src)

# —— phase 1 : lexage vers $gen (types), $x (textes), $gl (lignes) ——
$gen = [""]
$x = [""]
$gl = [0]
$i = 0
$suiv = -1
$c = 0
$cc = 0
$ok = 1
$t = ""
$nx = 0
$q = 0
$buf = ""
$txt = ""
$nu = ""
$dollar = 0
$flott = 0
$point_ok = 0
$lnr = 1

$cles = table()
inserer($cles, "fn", 1)
inserer($cles, "retour", 1)
inserer($cles, "si", 1)
inserer($cles, "sinon", 1)
inserer($cles, "tant_que", 1)
inserer($cles, "pour", 1)
inserer($cles, "de", 1)
inserer($cles, "vers", 1)
inserer($cles, "vrai", 1)
inserer($cles, "faux", 1)
inserer($cles, "et", 1)
inserer($cles, "ou", 1)
inserer($cles, "non", 1)
inserer($cles, "div", 1)
inserer($cles, "entier", 1)
inserer($cles, "rationnel", 1)
inserer($cles, "flottant", 1)
inserer($cles, "booleen", 1)
inserer($cles, "chaine", 1)
inserer($cles, "liste", 1)
inserer($cles, "table", 1)

tant_que ($i < $N) {
  $c = ordre($src[$i])
  $suiv = -1
  si ($i + 1 < $N) { $suiv = ordre($src[$i + 1]) }

  si ($c == 32 ou $c == 9 ou $c == 13 ou $c == 10) {
    si ($c == 10) { $lnr = $lnr + 1 }
    $i = $i + 1
  }
  sinon si ($c == 35 ou ($c == 47 et $suiv == 47)) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 34 ou $c == 39) {
    $q = $c
    $i = $i + 1
    $buf = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon {
        $cc = ordre($src[$i])
        si ($cc == 92) {
          si ($i + 1 >= $N) { $ok = 0 }
          sinon {
            $nx = ordre($src[$i + 1])
            si ($nx == 110) { $buf = $buf + "\n" }
            sinon si ($nx == 116) { $buf = $buf + "\t" }
            sinon si ($nx == 92 ou $nx == 34 ou $nx == 39) { $buf = $buf + sous_chaine($src, $i + 1, $i + 2) }
            sinon { $buf = $buf + "\\" + sous_chaine($src, $i + 1, $i + 2) }
            $i = $i + 2
          }
        }
        sinon si ($cc == $q) {
          $i = $i + 1
          $ok = 0
        }
        sinon {
          si ($cc == 10) { $lnr = $lnr + 1 }
          $buf = $buf + $src[$i]
          $i = $i + 1
        }
      }
    }
    joindre($gen, "chaine")
    joindre($x, $buf)
    joindre($gl, $lnr)
  }
  sinon si (est_chiffre($c)) {
    $txt = ""
    $flott = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_chiffre(ordre($src[$i]))) {
        $txt = $txt + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    $point_ok = 0
    si ($i < $N) {
      si ($i + 1 < $N) {
        si (ordre($src[$i]) == 46 et est_chiffre(ordre($src[$i + 1]))) { $point_ok = 1 }
      }
    }
    si ($point_ok == 1) {
      $flott = 1
      $txt = $txt + "."
      $i = $i + 1
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_chiffre(ordre($src[$i]))) {
          $txt = $txt + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
    }
    si ($flott == 1) { joindre($gen, "flottant") } sinon { joindre($gen, "nombre") }
    joindre($x, $txt)
    joindre($gl, $lnr)
  }
  sinon si ($c == 960) {
    joindre($gen, "flottant")
    joindre($x, "3.141592653589793")
    joindre($gl, $lnr)
    $i = $i + 1
  }
  sinon si ($c == 36 ou est_lettre($c)) {
    $dollar = 0
    si ($c == 36) { $dollar = 1; $i = $i + 1 }
    $nu = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_suite(ordre($src[$i]))) {
        $nu = $nu + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    si ($dollar == 1 ou cle_existe($cles, $nu)) { joindre($gen, "ident") }
    sinon { joindre($gen, "mot") }
    joindre($x, $nu)
    joindre($gl, $lnr)
  }
  sinon si (paire($c, $suiv) != "") {
    joindre($gen, paire($c, $suiv))
    joindre($x, sous_chaine($src, $i, $i + 2))
    joindre($gl, $lnr)
    $i = $i + 2
  }
  sinon si ($c == 62 et $suiv == 62) { joindre($gen, ">>"); joindre($x, ">>"); joindre($gl, $lnr); $i = $i + 2 }
  sinon si ($c == 60 et $suiv == 60) { joindre($gen, "<<"); joindre($x, "<<"); joindre($gl, $lnr); $i = $i + 2 }
  sinon si ($c == 45 et $suiv == 62) { joindre($gen, "->"); joindre($x, "->"); joindre($gl, $lnr); $i = $i + 2 }
  sinon si ($c == 61) { joindre($gen, "="); joindre($x, "="); joindre($gl, $lnr); $i = $i + 1 }
  sinon si ($c == 58 et $suiv == 58) { joindre($gen, "::"); joindre($x, "::"); joindre($gl, $lnr); $i = $i + 2 }
  sinon si ($c == 178) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "2"); joindre($gl, $lnr); $i = $i + 1 }
  sinon si ($c == 179) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "3"); joindre($gl, $lnr); $i = $i + 1 }
  sinon si (uni($c) != "") { joindre($gen, uni($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1 }
  sinon si (car($c) != "") { joindre($gen, car($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1 }
  sinon { $i = $i + 1 }
}
joindre($gen, "eof")
joindre($x, "")
joindre($gl, $lnr)

# —— phase 2 : descente vers les pools ——
$k = [""]
$tx = [""]
$tf = [""]
$a = [-1]
$b = [-1]
$as = [0]
$ac = [0]
$lg = [0]
$al = [-1]

$ik = [""]
$ino = [""]
$ie = [-1]
$ie2 = [-1]
$ib1 = [""]
$ib2 = [""]
$ilg = [0]

$fnoms = [""]
$fext = [""]
$fparams = [""]
$fret = [""]
$fcorps = [""]
$fligne = [0]

$foi = [-1]
$fot = [""]
$fof = [""]
$err = [""]
$tni = [0]
$tnt = [""]
$tri = [0]
$trt = [""]

$topb = ""
$p = 1
$dll = ""
$son = ""
$sym = ""

tant_que (T0($gen, $p) != "eof") {
  $t = T0($gen, $p)
  si ($t == ";") { $p = $p + 1 }
  sinon si ($t == "@" et (EMOT($gen, $x, $p + 1, "dll") ou EMOT($gen, $x, $p + 1, "sym"))) {
    $genre = VX0($x, $p + 1)
    $q = $p + 2
    si (T0($gen, $q) == "(") { $q = $q + 1 }
    si (T0($gen, $q) == "chaine") {
      si ($genre == "dll") { $dll = VX0($x, $q) }
      sinon { $sym = VX0($x, $q) }
      $q = $q + 1
      si (T0($gen, $q) == ",") {
        $q = $q + 1
        $son = VX0($x, $q)
        $q = $q + 1
      }
    }
    si (T0($gen, $q) == ")") { $q = $q + 1 }
    $p = $q
  }
  sinon si (EMOT($gen, $x, $p, "fn")) {
    $r = def_fn($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $fnoms, $fext, $fparams, $fret, $fcorps, $fligne)
    $p = SEPR($r)
  }
  sinon {
    $r = instruction($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $p = SEPR($r)
    si ($topb != "") { $topb = $topb + "," }
    $topb = $topb + NOD($r)
  }
}

# —— tri des fonctions par nom (ordre std::map) ——
$ordre = [0]
$nn = longueur($fnoms)
$w = 1
tant_que ($w < $nn) {
  $best = -1
  $j = 1
  tant_que ($j < $nn) {
    $pris = 0
    $u = 1
    $no2 = longueur($ordre)
    tant_que ($u < $no2) {
      si ($ordre[$u] == $j) { $pris = 1 }
      $u = $u + 1
    }
    si ($pris == 0) {
      si ($best < 0) { $best = $j }
      sinon si (cmp_str($fnoms[$j], $fnoms[$best]) < 0) { $best = $j }
    }
    $j = $j + 1
  }
  joindre($ordre, $best)
  $w = $w + 1
}

# —— passe 1 : repli de constantes (fonctions triées, puis niveau supérieur) ——
$w = 1
tant_que ($w < longueur($ordre)) {
  $ix = $ordre[$w]
  si ($fext[$ix] == "" et longueur($err) == 1) {
    replier_chaine($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
  $w = $w + 1
}
si (longueur($err) == 1) {
  replier_chaine($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                 $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
}

# —— passe 2 : vérification — d'abord les signatures, globals encore vides ——
$gln = [""]
$glt = [""]
$w = 1
tant_que ($w < longueur($ordre)) {
  si (longueur($err) == 1) {
    $ix = $ordre[$w]
    si ($fext[$ix] != "") {
      $ps = $fparams[$ix]
      $np = nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = piece($ps, 59, $u)
        $pp = premier_pipe($ent)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        $bb = BASE($pt)
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          lever($fligne[$ix], "Type " + nomty($pt) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
        $u = $u + 1
      }
      $bb = BASE($fret[$ix])
      si (longueur($err) == 1) {
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          lever($fligne[$ix], "Type " + nomty($fret[$ix]) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
      }
    }
    sinon {
      $lc = [""]
      $lct = [""]
      $ps = $fparams[$ix]
      $np = nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = piece($ps, 59, $u)
        $pp = premier_pipe($ent)
        $pn = sous_chaine($ent, 0, $pp)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        reserver($pn, 0, $err)
        env_put($pn, $pt, $lc, $lct)
        $u = $u + 1
      }
      parcourir($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $lc, $lct, $gln, $glt, $lc, $lct,
                $fnoms, $fparams, $fret, $foi, $fot, $fof, 1, $fret[$ix], $err, $tni, $tnt, $tri, $trt)
    }
  }
  $w = $w + 1
}

# —— passe 2 (suite) : instructions de tête, environnement = globales ——
$lc = [""]
$lct = [""]
si (longueur($err) == 1) {
  parcourir($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
            $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
            $gln, $glt, $gln, $glt, $lc, $lct,
            $fnoms, $fparams, $fret, $foi, $fot, $fof, 0, "vide|vide", $err, $tni, $tnt, $tri, $trt)
}

# —— passe 3 : émission RIR (oracle « rose rir ») ——
# Fonctions triées (ordre std::map, externes sans corps), puis le niveau
# supérieur sous $principal ; compteurs %t et suffixes de bloc sans reprise.
$tc = [-1]
$bc = [-1]
$outl = [""]
joindre($outl, "rir 1")
si (longueur($err) == 1) {
  $w = 1
  tant_que ($w < longueur($ordre)) {
    $ix = $ordre[$w]
    si ($fext[$ix] == "") {
      em_fonction("$" + $fnoms[$ix], $fparams[$ix], $fret[$ix], $fcorps[$ix],
                  $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                  $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $outl)
    }
    $w = $w + 1
  }
  em_fonction("$principal", "", "vide|vide", $topb,
              $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $outl)
}

// emetteur_cpp.rose — M4.4 V3 : traducteur RIR -> C++ (entiers + chaines + globals).
// Oracle : `rose build prog.rose -o sortie.cpp` (transpiler_rir du moteur).

// ---------- utilitaires chaînes ----------
fn trim($s: chaine) -> chaine {
  $n = longueur($s)
  $i_t = 0
  $stop = faux
  tant_que ($i_t < $n et $stop == faux) {
    $c = $s[$i_t]
    si ($c == ' ' ou $c == '\t') { $i_t = $i_t + 1 } sinon { $stop = vrai }
  }
  $j = $n
  $stop = faux
  tant_que ($j > $i_t et $stop == faux) {
    $c = $s[$j-1]
    si ($c == ' ' ou $c == '\t') { $j = $j - 1 } sinon { $stop = vrai }
  }
  retour sous_chaine($s, $i_t, $j)
}

fn cst_promu_gd($txt_t: chaine) -> booleen {
  $t_t = $txt_t
  si (longueur($t_t) > 0) {
    si ($t_t[0] == '-' ou $t_t[0] == '+') {
      $t_t = sous_chaine($t_t, 1, longueur($t_t))
    }
  }
  $i_t = 0
  tant_que ($i_t < longueur($t_t)) {
    si ($t_t[$i_t] < '0' ou $t_t[$i_t] > '9') { retour faux }
    $i_t = $i_t + 1
  }
  si (longueur($t_t) == 0) { retour faux }
  si (longueur($t_t) > 19) { retour vrai }
  si (longueur($t_t) == 19) {
    si ($t_t >= "4611686018427387904") { retour vrai }
  }
  retour faux
}

fn prefix_cst() -> chaine {
  // le lexer du moteur avale "@c" dans un littéral de chaîne (=> "") ; on le construit.
  retour "@" + "c"
}

fn premier_espace($s: chaine) -> entier {
  $i_t = 0
  $stop = faux
  tant_que ($i_t < longueur($s) et $stop == faux) {
    si ($s[$i_t] == ' ') { $stop = vrai } sinon { $i_t = $i_t + 1 }
  }
  retour $i_t
}

fn decoupe($s: chaine, $out: liste<chaine>) {
  $r = trim($s)
  $stop = faux
  tant_que ($stop == faux) {
    si (longueur($r) == 0) { $stop = vrai } sinon {
      $p = premier_espace($r)
      joindre($out, sous_chaine($r, 0, $p))
      $r = trim(sous_chaine($r, $p, longueur($r)))
    }
  }
}

// ————— flux d'éléments de listes (miroir des génériques du vérificateur) —————
// Le texte RIR écrit « : l » sans élément : liste<entier> comme liste<chaine>
// rendent la même signature. Le vérificateur, lui, connaît l'élément par la
// source. On le reconstruit : chaque couple (fonction, nom) porte la lettre
// devinée de son élément, nourrie par les « liste.push » / « call $joindre »,
// les « affect », les « ret » et les liaisons d'appels ; on itère jusqu'à ce
// que plus rien ne bouge. La lettre du retour d'une fonction se note sous le
// nom « %ret ».
fn dt_trouve($f: chaine, $m: chaine, $df: liste<chaine>, $dm: liste<chaine>) -> entier {
  // la dernière écriture gagne : la table ne fait qu'ajouter des lignes
  $ix = -1
  $q = 1
  tant_que ($q < longueur($df)) {
    si ($df[$q] == $f et $dm[$q] == $m) { $ix = $q }
    $q = $q + 1
  }
  retour $ix
}

fn dt_lire($f: chaine, $m: chaine, $df: liste<chaine>, $dm: liste<chaine>, $dl: liste<chaine>) -> chaine {
  $ix = dt_trouve($f, $m, $df, $dm)
  si ($ix >= 0) { retour $dl[$ix] }
  retour ""
}

// grave si elle est vide ou absente ; dit si cela a fait avancer le point fixe
fn dt_graver($f: chaine, $m: chaine, $lt: chaine, $df: liste<chaine>, $dm: liste<chaine>, $dl: liste<chaine>) -> booleen {
  si ($lt == "") { retour faux }
  $ix = dt_trouve($f, $m, $df, $dm)
  si ($ix < 0) {
    joindre($df, $f)
    joindre($dm, $m)
    joindre($dl, $lt)
    retour vrai
  }
  si ($dl[$ix] == "") {
    joindre($df, $f)
    joindre($dm, $m)
    joindre($dl, $lt)
    retour vrai
  }
  retour faux
}

// lettre d'un domaine complet : préfixe « liste< » → élément ; « table< » →
// cellule dynamique ; nom nu → lettre brute ; « ent » et inconnus → "z".
fn lettre_domaine($t_t: chaine) -> chaine {
  si (commence_par($t_t, "liste<")) {
    $el = sous_chaine($t_t, 6, longueur($t_t))
    $ferme = longueur($el) - 1
    si ($ferme >= 0) { $el = sous_chaine($el, 0, $ferme) }
    si (longueur($el) > 0) { retour $el[0] }
  }
  si (commence_par($t_t, "table<")) { retour "y" }
  si ($t_t == "ent") { retour "z" }
  retour $t_t
}

// lettre de l'élément produit par un jeton : constante reconnue, production
// du corps (suffixe de l'opcode, index d'une autre liste, retour d'appel)
// ou lettre déjà gravée du nom (paramètre / slot / temporaire).
fn lettre_valeur($tok: chaine, $cur: chaine, $deb: entier, $fin: entier, $tous: liste<chaine>, $df: liste<chaine>, $dm: liste<chaine>, $dl: liste<chaine>) -> chaine {
  si ($tok == "vrai" ou $tok == "faux") { retour "b" }
  si (commence_par($tok, prefix_cst())) {
    $v = sous_chaine($tok, 2, longueur($tok))
    si ($v == "vrai" ou $v == "faux") { retour "b" }
    si (contient_t($v, "/")) { retour "q" }
    si (contient_t($v, ".")) { retour "f" }
    retour "z"
  }
  si (commence_par($tok, "%") == faux) { retour "" }
  $q = $deb
  $pl = ""
  tant_que ($q <= $fin et $pl == "") {
    $lq = trim($tous[$q])
    si (commence_par($lq, $tok + " = ")) {
      $pl = trim(sous_chaine($lq, longueur($tok) + 3, longueur($lq)))
    }
    si ($pl == "") { $q = $q + 1 }
  }
  si ($pl == "") { retour dt_lire($cur, $tok, $df, $dm, $dl) }
  $to = [""]
  decoupe($pl, $to)
  si (longueur($to) < 2) { retour "" }
  $op = $to[1]
  $kz = 0
  $lc = ""
  $trovu = faux
  tant_que ($kz < longueur($op) et $trovu == faux) {
    si ($op[$kz] == '.') {
      $kp1 = $kz + 1
      si ($kp1 < longueur($op)) {
        $cc = $op[$kp1]
        si ($cc == 'z' ou $cc == 's' ou $cc == 'f' ou $cc == 'q' ou $cc == 'b' ou $cc == 'g') {
          $lc = $cc
          $trovu = vrai
        }
      }
    }
    si ($trovu == faux) { $kz = $kz + 1 }
  }
  si ($trovu) { retour $lc }
  si ($op == "index") {
    si (longueur($to) >= 3) { retour dt_lire($cur, $to[2], $df, $dm, $dl) }
  }
  si ($op == "call") {
    si (longueur($to) >= 3) { retour dt_lire($to[2], "%ret", $df, $dm, $dl) }
  }
  // production opaque (liste.new notamment) : la lettre Apprise par ailleurs
  // (pushes ultérieurs, aliasing « affect ») — le point fixe la comblera.
  retour dt_lire($cur, $tok, $df, $dm, $dl)
}

// ————— genre() : miroir de ty_of + dest_ty du transpiler (C++) —————
// Retourne la lettre de domaine d'un opérande RIR : z f s b q g l t u.
// Listes de contexte : $body (lignes), tables fn_noms/fn_ret, paramètres du
// cadre courant ($pnoms noms, $pletres lettres concaténées).
fn genre_t($tok: chaine, $body: liste<chaine>, $fn_noms: liste<chaine>, $fn_ret: liste<chaine>, $pnoms: liste<chaine>, $pletres: chaine, $curfn: chaine, $df: liste<chaine>, $dm: liste<chaine>, $dl: liste<chaine>) -> chaine {
  si (commence_par($tok, prefix_cst())) {
    $v = sous_chaine($tok, 2, longueur($tok))
    si (cst_promu_gd($v)) { retour "g" }
    si (contient_t($v, "/")) { retour "q" }
    si (contient_t($v, ".")) { retour "f" }
    retour "z"
  }
  si (commence_par($tok, "%") == faux) { retour "z" }
  $nm = sous_chaine($tok, 1, longueur($tok))
  // paramètre du cadre courant ?
  $j = 1
  tant_que ($j < longueur($pnoms)) {
    si ($pnoms[$j] == $nm) {
      $ix = $j - 1
      si ($ix >= 0) {
        si ($ix < longueur($pletres)) { retour $pletres[$ix] }
      }
    }
    $j = $j + 1
  }
  // produit par une instruction du corps ?
  $i_t = 1
  tant_que ($i_t < longueur($body)) {
    $bl = $body[$i_t]
    si (commence_par($bl, $tok + " = ")) {
      $rest = trim(sous_chaine($bl, longueur($tok) + 3, longueur($bl)))
      $toks = [""]
      decoupe($rest, $toks)
      si (longueur($toks) >= 2) {
        $op = $toks[1]
        si ($op == "cst.z") {
          si (longueur($toks) >= 3) {
            si (commence_par($toks[2], prefix_cst())) {
              $v2 = sous_chaine($toks[2], 2, longueur($toks[2]))
              si (cst_promu_gd($v2)) { retour "g" }
            }
          }
          retour "z"
        }
        si ($op == "cst.s") { retour "s" }
        si ($op == "cst.b") { retour "b" }
        si ($op == "cst.f") { retour "f" }
        si ($op == "cst.q") { retour "q" }
        si ($op == "liste.new") { retour "l" }
        si ($op == "add.f" ou $op == "sub.f" ou $op == "mul.f" ou $op == "div.f" ou $op == "neg.f" ou $op == "pow.f") { retour "f" }
        si ($op == "add.s") { retour "s" }
        si ($op == "add.q" ou $op == "sub.q" ou $op == "mul.q" ou $op == "div.q" ou $op == "pow.q") { retour "q" }
        si ($op == "add.z" ou $op == "sub.z" ou $op == "mul.z" ou $op == "neg.z" ou $op == "div.z" ou commence_par($op, "rem.z") ou commence_par($op, "divf") ou $op == "pow.z") {
          $j2 = 2
          tant_que ($j2 < longueur($toks)) {
            si (genre_t($toks[$j2], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl) == "g") { retour "g" }
            $j2 = $j2 + 1
          }
          retour "z"
        }
        si (commence_par($op, "cmp.")) { retour "b" }
        si ($op == "not.b" ou $op == "and.b" ou $op == "or.b") { retour "b" }
        si ($op == "index") {
          // base table -> cellule dynamique ; base non-liste -> rose_index_str
          // (chaine) ; base liste -> type du dernier élément poussé.
          $bt = "z"
          si (longueur($toks) >= 3) { $bt = genre_t($toks[2], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl) }
          si ($bt == "h") { retour "y" }
          si ($bt != "l") { retour "s" }
          // quand la base est une globale, les éléments peuvent avoir été
          // poussés sur le temporaire affecteur, avant l'affect.
          $srcg = ""
          $eglob = vrai
          $pt0 = 1
          tant_que ($pt0 < longueur($body)) {
            $blq = $body[$pt0]
            si (commence_par($blq, $toks[2] + " = ")) { $eglob = faux }
            si (commence_par($blq, "affect ")) {
              $tkq = [""]
              decoupe($blq, $tkq)
              si (longueur($tkq) >= 4) {
                $gnq = $tkq[3]
                si (longueur($gnq) > 0) {
                  si ($gnq[0] == '"') { $gnq = sous_chaine($gnq, 1, longueur($gnq) - 1) }
                }
                $baseb = $toks[2]
                si (commence_par($baseb, "%")) { $baseb = sous_chaine($baseb, 1, longueur($baseb)) }
                si ($gnq == $baseb) { $srcg = $tkq[2] }
              }
            }
            $pt0 = $pt0 + 1
          }
          $pt = 1
          $elt = "z"
          $elt_trou = faux
          tant_que ($pt < longueur($body)) {
            $blp = $body[$pt]
            si (commence_par($blp, "liste.push " + $toks[2] + " ")) {
              $restp2 = trim(sous_chaine($blp, 11 + longueur($toks[2]) + 1, longueur($blp)))
              $tokp = [""]
              decoupe($restp2, $tokp)
              si (longueur($tokp) >= 2) { $elt = genre_t($tokp[1], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl) }
              $elt_trou = vrai
            }
            si (commence_par($blp, "call $joindre " + $toks[2] + " ")) {
              $restj = trim(sous_chaine($blp, 15 + longueur($toks[2]), longueur($blp)))
              $tokj = [""]
              decoupe($restj, $tokj)
              si (longueur($tokj) >= 2) { $elt = genre_t($tokj[1], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl) }
              $elt_trou = vrai
            }
            si ($srcg != "") {
              si (commence_par($blp, "liste.push " + $srcg + " ")) {
                $rests = trim(sous_chaine($blp, 11 + longueur($srcg) + 1, longueur($blp)))
                $tokv = [""]
                decoupe($rests, $tokv)
                si (longueur($tokv) >= 2) { $elt = genre_t($tokv[1], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl) }
                $elt_trou = vrai
              }
            }
            $pt = $pt + 1
          }
          // aucun élément visible dans le corps : le vérificateur propage le
          // TYPE ATTENDU (miroir dest_ty). Un index consommé uniquement par
          // « ret » prend le type de retour de la fonction — sentinelle « r »
          // que la déclaration du temp remplace par la lettre courante (le
          // transpiler déclare rose_ent et entoure l'appel de
          // rose_a_entier(get_str(…))). Sinon l'élément inconnu se lit en
          // chaîne (rose_liste_get_str direct).
          si ($elt_trou == faux) {
          $un_ret = faux
          $autre_conso = faux
          $cq = 1
          tant_que ($cq < longueur($body)) {
            $blc = trim($body[$cq])
            $est_conso = faux
            $tkc = [""]
            decoupe($blc, $tkc)
            $c2 = 1
            tant_que ($c2 < longueur($tkc)) {
              si ($tkc[$c2] == $tok) { $est_conso = vrai }
              $c2 = $c2 + 1
            }
            si ($est_conso) {
              si (commence_par($blc, $tok + " = ")) {
                // production : pas une consommation
              } sinon si ($blc == "ret " + $tok) {
                si ($un_ret == faux) { $un_ret = vrai } sinon { $autre_conso = vrai }
              } sinon {
                $autre_conso = vrai
              }
            }
            $cq = $cq + 1
          }
          si ($un_ret et $autre_conso == faux) { retour "r" }
          si (longueur($toks) >= 3) {
            $ltb = dt_lire($curfn, $toks[2], $df, $dm, $dl)
            si ($ltb != "") { retour $ltb }
          }
          retour "s"
          }
          retour $elt
        }
        si ($op == "call") {
          $fname = "$"
          si (longueur($toks) >= 3) { $fname = $toks[2] }
          si (longueur($fname) > 0) {
            si ($fname[0] == '$') { $fname = sous_chaine($fname, 1, longueur($fname)) }
          }
          // fonction utilisateur : lettre de retour déclarée
          $j3 = 1
          tant_que ($j3 < longueur($fn_noms)) {
            si ($fn_noms[$j3] == $fname) { retour $fn_ret[$j3] }
            $j3 = $j3 + 1
          }
          // intrinsèques à domaine mixte : propagation grand entier
          si ($fname == "pgcd" ou $fname == "ppcm" ou $fname == "abs" ou $fname == "min" ou $fname == "max") {
            $j4 = 3
            tant_que ($j4 < longueur($toks)) {
              si (genre_t($toks[$j4], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl) == "g") { retour "g" }
              $j4 = $j4 + 1
            }
          }
          si ($fname == "abs" ou $fname == "min" ou $fname == "max") {
            $j5 = 3
            $fq = ""
            tant_que ($j5 < longueur($toks)) {
              $gt = genre_t($toks[$j5], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl)
              si ($gt == "f" et longueur($fq) == 0) { $fq = "f" }
              si ($gt == "q" et longueur($fq) == 0) { $fq = "q" }
              $j5 = $j5 + 1
            }
            si (longueur($fq) > 0) { retour $fq }
          }
          si ($fname == "octets" ou $fname == "tampon") { retour "t" }
          si ($fname == "table") { retour "h" }
          si ($fname == "cles" ou $fname == "valeurs") { retour "l" }
          si ($fname == "cle_existe" ou $fname == "supprimer") { retour "b" }
          si ($fname == "fraction") { retour "q" }
          si ($fname == "flottant") { retour "f" }
          si ($fname == "fibonacci" ou $fname == "factorielle" ou $fname == "puissance") { retour "g" }
          si ($fname == "millisecondes" ou $fname == "nb_arguments" ou $fname == "entier" ou $fname == "tampon_case" ou $fname == "nb_chiffres") { retour "z" }
          si ($fname == "compter_premiers" ou $fname == "pgcd" ou $fname == "ppcm" ou $fname == "hasard" ou $fname == "ordre" ou $fname == "temps") { retour "z" }
          si ($fname == "partie_entiere") { retour "z" }
          si ($fname == "entier_f" ou $fname == "partie_entiere_f") { retour "f" }
          si ($fname == "argument" ou $fname == "chaine" ou $fname == "nombre_pi" ou $fname == "lire_texte") { retour "s" }
          si ($fname == "sous_chaine" ou $fname == "caractere" ou $fname == "duree" ou $fname == "concatener") { retour "s" }
          si ($fname == "est_premier") { retour "b" }
          retour "z"
        }
      }
      retour "z"
    }
    $i_t = $i_t + 1
  }
  // global : dernière affect %t "nom"
  $nomg = $nm
  $i_t = 1
  tant_que ($i_t < longueur($body)) {
    $bl = $body[$i_t]
    si (commence_par($bl, "affect ")) {
      $toks2 = [""]
      decoupe(sous_chaine($bl, 7, longueur($bl)), $toks2)
      si (longueur($toks2) >= 3) {
        $gn = $toks2[2]
        si (longueur($gn) > 1) {
          si ($gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn) - 1) }
        }
        si ($gn == $nomg) {
          // le genre de la SOURCE du premier affect (le vérificateur interdit
          // les changements de domaine : la première écriture tape le slot,
          // comme temp_types["%nom"] chez l'oracle). La source peut etre un
          // PARAMETRE — genre sait le resoudre.
          retour genre_t($toks2[1], $body, $fn_noms, $fn_ret, $pnoms, $pletres, $curfn, $df, $dm, $dl)
        }
      }
    }
    $i_t = $i_t + 1
  }
  retour "z"
}

// la valeur produite par l'instruction du temp $tname (%t…) est-elle un grand entier ?
fn inst_est_gd($tname: chaine, $body: liste<chaine>) -> booleen {
  $i_t = 1
  tant_que ($i_t < longueur($body)) {
    $bl = $body[$i_t]
    si (commence_par($bl, $tname + " = ")) {
      $rest = trim(sous_chaine($bl, longueur($tname) + 3, longueur($bl)))
      $toks = [""]
      decoupe($rest, $toks)
      si (longueur($toks) >= 2) {
        $op = $toks[1]
        si ($op == "cst.z") {
          si (longueur($toks) >= 3) {
            si (commence_par($toks[2], prefix_cst())) {
              $val = sous_chaine($toks[2], 2, longueur($toks[2]))
              retour cst_promu_gd($val)
            }
          }
        }
        si ($op == "add.z" ou $op == "sub.z" ou $op == "mul.z") {
          $j = 2
          tant_que ($j < longueur($toks)) {
            si (operande_est_gd($toks[$j], $body)) { retour vrai }
            $j = $j + 1
          }
        }
      }
    }
    $i_t = $i_t + 1
  }
  retour faux
}

// l'opérande (@c constante énorme, temp gd, ou global gd) est-elle un grand entier ?
fn operande_est_gd($operand: chaine, $body: liste<chaine>) -> booleen {
  si (commence_par($operand, prefix_cst())) {
    retour cst_promu_gd(sous_chaine($operand, 2, longueur($operand)))
  }
  si (commence_par($operand, "%")) {
    $i_t = 1
    $est_temp = faux
    tant_que ($i_t < longueur($body)) {
      si (commence_par($body[$i_t], $operand + " = ")) { $est_temp = vrai }
      $i_t = $i_t + 1
    }
    si ($est_temp) { retour inst_est_gd($operand, $body) }
    // sinon un global affect %t "nom"
    $name = sous_chaine($operand, 1, longueur($operand))
    $i_t = 1
    tant_que ($i_t < longueur($body)) {
      $bl = $body[$i_t]
      si (commence_par($bl, "affect ")) {
        $toks = [""]
        decoupe(sous_chaine($bl, 7, longueur($bl)), $toks)
        si (longueur($toks) >= 2) {
          $gn = $toks[2]
          si (longueur($gn) > 1) {
            si ($gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn) - 1) }
          }
          si ($gn == $name) { retour inst_est_gd($toks[1], $body) }
        }
      }
      $i_t = $i_t + 1
    }
  }
  retour faux
}

fn est_vide($s: chaine) -> booleen {
  retour longueur(trim($s)) == 0
}

fn commence_par($s: chaine, $p: chaine) -> booleen {
  $lp = longueur($p)
  si (longueur($s) < $lp) { retour faux }
  retour sous_chaine($s, 0, $lp) == $p
}

fn contient_t($s: chaine, $p: chaine) -> booleen {
  $ls = longueur($s)
  $lp = longueur($p)
  $i_t = 0
  tant_que ($i_t + $lp <= $ls) {
    si (sous_chaine($s, $i_t, $i_t + $lp) == $p) { retour vrai }
    $i_t = $i_t + 1
  }
  retour faux
}

// ---------- découpage en lignes (rembourrée) ----------
fn lignes($src_t: chaine) -> liste<chaine> {
  $out = [""]
  $n = longueur($src_t)
  $cur = ""
  $i_t = 0
  tant_que ($i_t < $n) {
    $c = $src_t[$i_t]
    si ($c == '\n') { joindre($out, $cur); $cur = "" }
    sinon { $cur = $cur + $c }
    $i_t = $i_t + 1
  }
  joindre($out, $cur)
  retour $out
}

// ---------- helpers RIR ----------
fn nom_fonction($l: chaine) -> chaine {
  $rest = trim(sous_chaine($l, 9, longueur($l)))
  $k_t = 0
  tant_que ($k_t < longueur($rest) et $rest[$k_t] != '(') { $k_t = $k_t + 1 }
  retour trim(sous_chaine($rest, 0, $k_t))
}

// lettre de type RIR -> nom C++
fn nom_type($t_t: chaine) -> chaine {
  si ($t_t == "z") { retour "rose_ent" }
  si ($t_t == "u") { retour "int" }
  si ($t_t == "f") { retour "rose_float" }
  si ($t_t == "s") { retour "rose_str" }
  si ($t_t == "q") { retour "rose_qd" }
  si ($t_t == "g") { retour "rose_gd" }
  si ($t_t == "b") { retour "rose_bool" }
  si ($t_t == "l") { retour "rose_liste" }
  si ($t_t == "t") { retour "rose_tampon" }
  si ($t_t == "h") { retour "rose_table" }
  si ($t_t == "y") { retour "rose_dyn" }
  retour "rose_ent"
}

// lettre de type d'un paramètre RIR « nom %nom : t » ("" si absente)
fn lettre_param($part: chaine) -> chaine {
  $k_t = 0
  $deux = -1
  tant_que ($k_t < longueur($part)) {
    si ($part[$k_t] == ':') { $deux = $k_t }
    $k_t = $k_t + 1
  }
  si ($deux < 0) { retour "z" }
  $k_t = $deux + 1
  $stop = faux
  tant_que ($k_t < longueur($part) et $stop == faux) {
    si ($part[$k_t] != ' ') { $stop = vrai } sinon { $k_t = $k_t + 1 }
  }
  si ($k_t >= longueur($part)) { retour "z" }
  retour $part[$k_t]
}

// lettre brute du retour RIR (« -> t »), « u » par défaut
fn lettre_retour($l: chaine) -> chaine {
  $rest = trim(sous_chaine($l, 9, longueur($l)))
  $fleche = 0
  $trouve = faux
  tant_que ($fleche + 1 < longueur($rest) et $trouve == faux) {
    si (sous_chaine($rest, $fleche, $fleche+2) == "->") { $trouve = vrai }
    sinon { $fleche = $fleche + 1 }
  }
  si ($trouve == faux) { retour "u" }
  $tyraw = trim(sous_chaine($rest, $fleche+2, longueur($rest)))
  si (longueur($tyraw) == 0) { retour "u" }
  retour $tyraw[0]
}

fn type_retour($l: chaine) -> chaine {
  $rest = trim(sous_chaine($l, 9, longueur($l)))
  $fleche = 0
  $trouve = faux
  tant_que ($fleche + 1 < longueur($rest) et $trouve == faux) {
    si (sous_chaine($rest, $fleche, $fleche+2) == "->") { $trouve = vrai }
    sinon { $fleche = $fleche + 1 }
  }
  si ($trouve == faux) { retour "rose_ent" }
  $tyraw = trim(sous_chaine($rest, $fleche+2, longueur($rest)))
  $brace = 0
  tant_que ($brace < longueur($tyraw) et $tyraw[$brace] != '{' et $tyraw[$brace] != ' ') { $brace = $brace + 1 }
  $tyraw = trim(sous_chaine($tyraw, 0, $brace))
  si ($tyraw == "z") { retour "rose_ent" }
  si ($tyraw == "f") { retour "rose_float" }
  si ($tyraw == "s") { retour "rose_str" }
  si ($tyraw == "q") { retour "rose_qd" }
  si ($tyraw == "b") { retour "rose_bool" }
  si ($tyraw == "l") { retour "rose_liste" }
  retour "rose_ent"
}

fn c_name($nom: chaine) -> chaine {
  si ($nom == "$principal" ou $nom == "principal") { retour "main" }
  retour "r_" + sous_chaine($nom, 1, longueur($nom))
}

// Le moteur n'ecourt-circuite pas « et » / « ou » : $x[0] serait evalue
// meme sur une chaine vide (erreur runtime). premier_car renvoie ' ' pour
// le vide — ne coincide jamais avec un separateur recherche.
fn premier_car($x: chaine) -> chaine {
  si (longueur($x) > 0) { retour $x[0] }
  retour " "
}

fn sanitize($name: chaine) -> chaine {
  $s = $name
  si (premier_car($s) == '%' ou premier_car($s) == '$') {
    $s = sous_chaine($s, 1, longueur($s))
  }
  retour "r_" + $s
}

fn operand($tok: chaine, $flag: liste<chaine>) -> chaine {
  $t_t = trim($tok)
  // lecture d'une globale marquée : garde rose_lit (miroir L() du transpiler)
  si (commence_par($t_t, "%")) {
    $nm = sous_chaine($t_t, 1, longueur($t_t))
    $fi = 1
    tant_que ($fi < longueur($flag)) {
      si ($flag[$fi] == $nm) {
        retour "rose_lit(r_" + $nm + ", _def_r_" + $nm + ", \"" + $nm + "\")"
      }
      $fi = $fi + 1
    }
  }
  si (longueur($t_t) == 0) { retour "0" }
  si ($t_t[0] == '%') { retour "r_" + sous_chaine($t_t, 1, longueur($t_t)) }
  si ($t_t[0] == '$') { retour "r_" + sous_chaine($t_t, 1, longueur($t_t)) }
  si (commence_par($t_t, prefix_cst())) {
    retour sous_chaine($t_t, 2, longueur($t_t))
  }
  retour $t_t
}

// type d'un temp selon l'op qui le produit
// constante texte d'un opérande de concaténation : guillemets + echappement
// des guillemets et antislashs (miroir exact de la branche add.s).
fn texte_const($tok: chaine) -> chaine {
  $t_t = $tok
  si (commence_par($t_t, prefix_cst())) { $t_t = sous_chaine($t_t, 2, longueur($t_t)) }
  $out = ""
  $k_t = 0
  tant_que ($k_t < longueur($t_t)) {
    $c = $t_t[$k_t]
    si ($c == '"') { $out = $out + "\\\"" }
    sinon si ($c == "\\") { $out = $out + "\\\\" }
    sinon si ($c == "\n") { $out = $out + "\\n" }
    sinon si ($c == "\t") { $out = $out + "\\t" }
    sinon { $out = $out + $c }
    $k_t = $k_t + 1
  }
  retour "\"" + $out + "\""
}

// littérale C++ d'une constante texte du RIR : guillemets + echappement des
// antislashs et guillemets (miroir cst.s du transpileur, qui tient les
// constantes en mémoire et les rend telles quelles).
fn chaine_cpp($v: chaine) -> chaine {
  $out = ""
  $k_t = 0
  tant_que ($k_t < longueur($v)) {
    $c = $v[$k_t]
    si ($c == '"') { $out = $out + "\\\"" }
    sinon si ($c == "\\") { $out = $out + "\\\\" }
    sinon si ($c == "\n") { $out = $out + "\\n" }
    sinon si ($c == "\t") { $out = $out + "\\t" }
    sinon { $out = $out + $c }
    $k_t = $k_t + 1
  }
  retour "\"" + $out + "\""
}

// instruction de poussée selon le genre de l'élément (miroir liste.push)
fn pousse_texte($lst: chaine, $el: chaine, $ety: chaine) -> chaine {
  si ($ety == "s") { retour "    rose_liste_push(" + $lst + ", " + $el + ".c_str());" }
  si ($ety == "g") { retour "    rose_liste_push_gd(" + $lst + ", " + $el + ");" }
  si ($ety == "q") { retour "    rose_liste_push_q(" + $lst + ", " + $el + ");" }
  si ($ety == "f") { retour "    rose_liste_push_flt(" + $lst + ", " + $el + ");" }
  retour "    rose_liste_push_int(" + $lst + ", " + $el + ");"
}

fn temp_type_of($op: chaine) -> chaine {
  si (commence_par($op, "cmp.")) { retour "b" }
  si ($op == "not.b" ou $op == "and.b" ou $op == "or.b") { retour "b" }
  si ($op == "liste.new") { retour "l" }
  si ($op == "cst.z") { retour "z" }
  si ($op == "cst.s") { retour "s" }
  si ($op == "cst.f") { retour "f" }
  si ($op == "cst.b") { retour "b" }
  si ($op == "cst.q") { retour "q" }
  si ($op == "add.q" ou $op == "sub.q" ou $op == "mul.q" ou $op == "div.q") { retour "q" }
  si ($op == "add.z" ou $op == "sub.z" ou $op == "mul.z" ou $op == "neg.z") { retour "z" }
  si ($op == "add.s") { retour "s" }
  si ($op == "sous_chaine") { retour "s" }
  si ($op == "caractere") { retour "s" }
  si ($op == "add.f" ou $op == "sub.f" ou $op == "mul.f" ou $op == "div.f" ou $op == "neg.f") { retour "f" }
  retour "z"
}

fn cpp_type_name($t_t: chaine) -> chaine {
  si ($t_t == "h") { retour "rose_table" }
  si ($t_t == "y") { retour "rose_dyn" }
  si ($t_t == "t") { retour "rose_tampon" }
  si ($t_t == "g") { retour "rose_gd" }
  si ($t_t == "s") { retour "rose_str" }
  si ($t_t == "f") { retour "rose_float" }
  si ($t_t == "b") { retour "rose_bool" }
  si ($t_t == "q") { retour "rose_qd" }
  si ($t_t == "l") { retour "rose_liste" }
  retour "rose_ent"
}

// ---------- principal ----------
// Parcours en profondeur du graphe d'appels ($edges = entrées plates
// « source cible »). Retourne vrai si un cycle existe — le transpileur C++
// pose alors rose_pile_geante dans main (récursives : pile de 512 Mo).
fn graphe_cycle($nom: chaine, $edges: liste<chaine>, $visites: liste<chaine>, $pile: chaine) -> booleen {
  $p2 = $pile + $nom + " "
  $e = 1
  tant_que ($e < longueur($edges)) {
    $ent = $edges[$e]
    si (commence_par($ent, $nom + " ")) {
      $m = sous_chaine($ent, longueur($nom) + 1, longueur($ent))
      si ($m != "") {
        si (contient_t($p2, " " + $m + " ")) { retour vrai }
        $deja = faux
        $qv2 = 1
        tant_que ($qv2 < longueur($visites)) {
          si ($visites[$qv2] == $m) { $deja = vrai }
          $qv2 = $qv2 + 1
        }
        si ($deja == faux) {
          joindre($visites, $m)
          si (graphe_cycle($m, $edges, $visites, $p2)) { retour vrai }
        }
      }
    }
    $e = $e + 1
  }
  retour faux
}


// ---------- driver M4.5 : rejet poli du front-end, sinon émission C++ ----------
si (longueur($err) > 1) {
  >> $err[1]
} sinon {
// ---------- racine : le corps du traducteur (le bloc racine EST le principal) ----------
  // couture M4.5 : le RIR vient du front-end en mémoire (plus de fichier)
  $ls = $outl
  $n = longueur($ls)

  // en-tête
  >> "#include \"rose_runtime.h\""
  >> "#include <cstdint>"
  >> "#include <cstdio>"
  >> "#include <string>"
  >> ""

  // tables des fonctions utilisateur : noms, lettres de retour, lettres de
  // paramètres (concaténées, une par paramètre) — pour les conversions d'appels.
  $fn_noms = [""]
  $fn_rets = [""]
  $fn_pars = [""]
  // arêtes du graphe d'appels, entrées plates « source cible »
  $edges = [""]
  $cour_idx = 0

  // table COMPLÈTE des fonctions usagères, avant toute arête : un appel vers
  // une fonction définie plus bas dans le RIR compte aussi (réciprocité).
  $fn_tous = [""]
  $j0 = 1
  tant_que ($j0 < $n) {
    $l0 = trim($ls[$j0])
    si (commence_par($l0, "fonction ")) {
      $nom0 = nom_fonction($l0)
      si ($nom0 != "$principal" et $nom0 != "principal") {
        $nomc0 = $nom0
        si (commence_par($nomc0, "$")) { $nomc0 = sous_chaine($nomc0, 1, longueur($nomc0)) }
        joindre($fn_tous, $nomc0)
      }
    }
    $j0 = $j0 + 1
  }

  // première passe : déclarations avancées
  $i_t = 1
  tant_que ($i_t < $n) {
    $l = trim($ls[$i_t])
    si (commence_par($l, "fonction ")) {
      $nom = nom_fonction($l)
      $cour_idx = 0
      si ($nom != "$principal" et $nom != "principal") {
        $cname = c_name($nom)
        // collecte table (nom sans le $)
        $nomc = $nom
        si (commence_par($nomc, "$")) { $nomc = sous_chaine($nomc, 1, longueur($nomc)) }
        joindre($fn_noms, $nomc)
        joindre($fn_rets, lettre_retour($l))
        $restp = trim(sous_chaine($l, 9, longueur($l)))
        $kp0 = 0
        tant_que ($kp0 < longueur($restp) et $restp[$kp0] != '(') { $kp0 = $kp0 + 1 }
        $kp1 = $kp0
        tant_que ($kp1 < longueur($restp) et $restp[$kp1] != ')') { $kp1 = $kp1 + 1 }
        $prp = ""
        si ($kp1 > $kp0) { $prp = sous_chaine($restp, $kp0+1, $kp1) }
        $lettres = ""
        $ppp = trim($prp)
        si (longueur($ppp) > 0) {
          $partsp = [""]
          $curp = ""
          $kp = 0
          tant_que ($kp < longueur($ppp)) {
            si ($ppp[$kp] == ',') { joindre($partsp, trim($curp)); $curp = "" }
            sinon { $curp = $curp + $ppp[$kp] }
            $kp = $kp + 1
          }
          si (longueur(trim($curp)) > 0) { joindre($partsp, trim($curp)) }
          $pkp = 1
          tant_que ($pkp < longueur($partsp)) {
            $lettres = $lettres + lettre_param($partsp[$pkp])
            $pkp = $pkp + 1
          }
        }
        joindre($fn_pars, $lettres)
        $cour_idx = longueur($fn_pars) - 1
        // params
        $rest = trim(sous_chaine($l, 9, longueur($l)))
        $k0 = 0
        tant_que ($k0 < longueur($rest) et $rest[$k0] != '(') { $k0 = $k0 + 1 }
        $k1 = $k0
        tant_que ($k1 < longueur($rest) et $rest[$k1] != ')') { $k1 = $k1 + 1 }
        $pr = ""
        si ($k1 > $k0) { $pr = sous_chaine($rest, $k0+1, $k1) }
        $fwd = type_retour($l) + " " + $cname + "("
        $pp_t = trim($pr)
        si (longueur($pp_t) > 0) {
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($pp_t)) {
            $ch = $pp_t[$k_t]
            si ($ch == ',') { joindre($parts, trim($cur)); $cur = "" }
            sinon { $cur = $cur + $ch }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          $first = vrai
          $pk = 1
          tant_que ($pk < longueur($parts)) {
            $part = $parts[$pk]
            $pct = 0
            tant_que ($pct < longueur($part) et $part[$pct] != '%') { $pct = $pct + 1 }
            $after = trim(sous_chaine($part, $pct, longueur($part)))
            $sp = 0
            tant_que ($sp < longueur($after) et $after[$sp] != ' ' et $after[$sp] != ':') { $sp = $sp + 1 }
            $varname = trim(sous_chaine($after, 0, $sp))
            si (premier_car($varname) == '%') { $varname = sous_chaine($varname, 1, longueur($varname)) }
            si ($first == faux) { $fwd = $fwd + ", " }
            $first = faux
            // v3.14.1 — les listes voyagent par RÉFÉRENCE (miroir du transpiler)
            $ptf = nom_type(lettre_param($part))
            si ($ptf == "rose_liste") { $ptf = "rose_liste&" }
            $fwd = $fwd + $ptf + " r_" + $varname
            $pk = $pk + 1

          }
        }
        $fwd = $fwd + ");"
        >> $fwd
      }
    } sinon si ($cour_idx > 0) {
      // arête d'appel vers une fonction usagère (pour la détection de cycle).
      // Position d'opérateur STRICTE : le mot « call » doit être l'opcode de
      // l'instruction, jamais un mot d'une constante texte.
      si (contient_t($l, " call ") ou commence_par($l, "call ")) {
        $tke = [""]
        decoupe($l, $tke)
        $cib = ""
        si (longueur($tke) >= 5) {
          si ($tke[2] == "=" et $tke[3] == "call") { $cib = $tke[4] }
        }
        si (longueur($tke) >= 3) {
          si ($tke[1] == "call") { $cib = $tke[2] }
        }
        si (commence_par($cib, "$")) {
              $cibn = sous_chaine($cib, 1, longueur($cib))
              $in = faux
              $q2 = 1
              tant_que ($q2 < longueur($fn_tous)) {
                si ($fn_tous[$q2] == $cibn) { $in = vrai }
                $q2 = $q2 + 1
              }
              si ($in) {
                $srcn = $fn_noms[$cour_idx]
                $dup = faux
                $q3 = 1
                tant_que ($q3 < longueur($edges)) {
                  si ($edges[$q3] == $srcn + " " + $cibn) { $dup = vrai }
                  $q3 = $q3 + 1
                }
                si ($dup == faux) { joindre($edges, $srcn + " " + $cibn) }
              }
        }
      }
    }
    $i_t = $i_t + 1
  }
  >> ""

  // récursivité (miroir du transpileur) : un cycle dans le graphe d'appels
  // des fonctions usagères impose rose_pile_geante en tête de main.
  $recursif = faux
  $visites = [""]
  $rr = 1
  tant_que ($rr < longueur($fn_noms) et $recursif == faux) {
    $rn = $fn_noms[$rr]
    $vu = faux
    $qv = 1
    tant_que ($qv < longueur($visites)) {
      si ($visites[$qv] == $rn) { $vu = vrai }
      $qv = $qv + 1
    }
    si ($vu == faux) {
      joindre($visites, $rn)
      si (graphe_cycle($rn, $edges, $visites, " ")) { $recursif = vrai }
    }
    $rr = $rr + 1
  }

  // ---------- passe M4.5 : flux d'éléments des listes (génériques effacés
  // du texte RIR par la signature « : l », reconstitués par points fixes) ----------
  $dt_fn = [""]
  $dt_nm = [""]
  $dt_lt = [""]
  $dt_pns = [""]
  $rg_fn = [""]
  $rg_a = [""]
  $rg_b = [""]
  $dp = 1
  $dn_cour = ""
  tant_que ($dp < $n) {
    $dl0 = trim($ls[$dp])
    si (commence_par($dl0, "fonction ")) {
      $dn_cour = nom_fonction($dl0)
      si ($dn_cour != "") {
        joindre($rg_fn, $dn_cour)
        $dpa1 = $dp + 1
        joindre($rg_a, chaine($dpa1))
        // fin du corps : première ligne « } » qui suit (pré-passe O(n) au total)
        $dq0 = $dp
        $dfin = $n
        $ferme = faux
        tant_que ($dq0 < $n et $ferme == faux) {
          $dq0 = $dq0 + 1
          si ($dq0 < $n) {
            $lq0 = trim($ls[$dq0])
            si ($lq0 == "}") {
              $dfin = $dq0 - 1
              $ferme = vrai
            }
          }
        }
        joindre($rg_b, chaine($dfin))
        // %noms des paramètres, dans l'ordre de $fn_pars
        $drp = trim(sous_chaine($dl0, 9, longueur($dl0)))
        $da = 0
        tant_que ($da < longueur($drp) et $drp[$da] != '(') { $da = $da + 1 }
        $db = $da
        tant_que ($db < longueur($drp) et $drp[$db] != ')') { $db = $db + 1 }
        $dpp = ""
        si ($db > $da) { $dpp = trim(sous_chaine($drp, $da + 1, $db)) }
        $dens = ""
        si (longueur($dpp) > 0) {
          $dparts = [""]
          $dcur = ""
          $dc = 0
          tant_que ($dc < longueur($dpp)) {
            si ($dpp[$dc] == ',') { joindre($dparts, trim($dcur)); $dcur = "" }
            sinon { $dcur = $dcur + $dpp[$dc] }
            $dc = $dc + 1
          }
          si (longueur(trim($dcur)) > 0) { joindre($dparts, trim($dcur)) }
          $dn2 = 1
          tant_que ($dn2 < longueur($dparts)) {
            $dun = $dparts[$dn2]
            $de = 0
            tant_que ($de < longueur($dun) et $dun[$de] != '%') { $de = $de + 1 }
            $dg = $de
            tant_que ($dg < longueur($dun) et $dun[$dg] != ' ' et $dun[$dg] != ':') { $dg = $dg + 1 }
            si ($de < longueur($dun)) { $dens = $dens + sous_chaine($dun, $de, $dg) + " " }
            $dn2 = $dn2 + 1
          }
        }
        joindre($dt_pns, $dens)
      }
    }
    $dp = $dp + 1
  }
  $dt_change = vrai
  $dt_passe = 0
  tant_que ($dt_change et $dt_passe < 40) {
    $dt_change = faux
    $dt_passe = $dt_passe + 1
    $zi = 1
    tant_que ($zi < longueur($rg_fn)) {
      $zf = $rg_fn[$zi]
      $za = entier($rg_a[$zi])
      $zb = entier($rg_b[$zi])
      $zq = $za
      tant_que ($zq <= $zb) {
        $lz = trim($ls[$zq])
        $tz = [""]
        decoupe($lz, $tz)
        si (longueur($tz) >= 3) {
          // (a) liste.push %base %valeur
          si ($tz[1] == "liste.push") {
            si (longueur($tz) >= 4) {
            si (commence_par($tz[2], "%")) {
              $lv = lettre_valeur($tz[3], $zf, $za, $zb, $ls, $dt_fn, $dt_nm, $dt_lt)
              si (dt_graver($zf, $tz[2], $lv, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
            }
            }
          }
          // (a2) call $joindre %base %valeur
          si ($tz[1] == "call") {
            si ($tz[2] == "$joindre") {
              si (longueur($tz) >= 5) {
                si (commence_par($tz[3], "%")) {
                  $lvj = lettre_valeur($tz[4], $zf, $za, $zb, $ls, $dt_fn, $dt_nm, $dt_lt)
                  si (dt_graver($zf, $tz[3], $lvj, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
                }
              }
            }
          }
          // (b) affect %source "slot" → le slot prend la lettre de sa source
          si ($tz[1] == "affect") {
            si (longueur($tz) >= 4) {
            si (commence_par($tz[2], "%")) {
              $dsn = sous_chaine($tz[3], 1, longueur($tz[3]) - 1)
              $lvs = lettre_valeur($tz[2], $zf, $za, $zb, $ls, $dt_fn, $dt_nm, $dt_lt)
              si (dt_graver($zf, "%" + $dsn, $lvs, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
            }
            }
          }
          // (c) ret %valeur → lettre de retour de la fonction (clé « %ret »)
          si ($tz[1] == "ret") {
            $lvr = lettre_valeur($tz[2], $zf, $za, $zb, $ls, $dt_fn, $dt_nm, $dt_lt)
            si (dt_graver($zf, "%ret", $lvr, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
          }
          // (d) %dest = call $G arguments : dest := retour, formels « l » := réels
          si ($tz[2] == "=") {
            si (longueur($tz) >= 5) {
            si ($tz[3] == "call") {
              si (commence_par($tz[4], "$")) {
                $gnet = sous_chaine($tz[4], 1, longueur($tz[4]))
                $gix = 0
                $jn = 1
                tant_que ($jn < longueur($fn_noms)) {
                  si ($fn_noms[$jn] == $gnet) { $gix = $jn }
                  $jn = $jn + 1
                }
                si ($gix >= 1) {
                  si (commence_par($tz[1], "%")) {
                    $lre = dt_lire($tz[4], "%ret", $dt_fn, $dt_nm, $dt_lt)
                    si (dt_graver($zf, $tz[1], $lre, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
                  }
                  $dtp = [""]
                  decoupe($dt_pns[$gix], $dtp)
                  $dlt = $fn_pars[$gix]
                  $dka = 1
                  tant_que ($dka < longueur($dtp)) {
                    $dix = $dka - 1
                    si ($dix < longueur($dlt)) {
                      si ($dlt[$dix] == 'l') {
                        $dix2 = 4 + $dka
                        si ($dix2 < longueur($tz)) {
                          si (commence_par($tz[$dix2], "%")) {
                            $lab = dt_lire($zf, $tz[$dix2], $dt_fn, $dt_nm, $dt_lt)
                            si (dt_graver($tz[4], $dtp[$dka], $lab, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
                          }
                        }
                      }
                    }
                    $dka = $dka + 1
                  }
                }
              }
            }
            }
          }
          // (d2) call $G arguments sans dest : liaisons formels « l » := réels
          si ($tz[1] == "call") {
            si (commence_par($tz[2], "$")) {
              si ($tz[2] != "$joindre") {
                $gnet2 = sous_chaine($tz[2], 1, longueur($tz[2]))
                $gix2 = 0
                $jn2 = 1
                tant_que ($jn2 < longueur($fn_noms)) {
                  si ($fn_noms[$jn2] == $gnet2) { $gix2 = $jn2 }
                  $jn2 = $jn2 + 1
                }
                si ($gix2 >= 1) {
                  $dtp2 = [""]
                  decoupe($dt_pns[$gix2], $dtp2)
                  $dlt2 = $fn_pars[$gix2]
                  $dka2 = 1
                  tant_que ($dka2 < longueur($dtp2)) {
                    $dixb = $dka2 - 1
                    si ($dixb < longueur($dlt2)) {
                      si ($dlt2[$dixb] == 'l') {
                        $dix2b = 2 + $dka2
                        si ($dix2b < longueur($tz)) {
                          si (commence_par($tz[$dix2b], "%")) {
                            $lab2 = dt_lire($zf, $tz[$dix2b], $dt_fn, $dt_nm, $dt_lt)
                            si (dt_graver($tz[2], $dtp2[$dka2], $lab2, $dt_fn, $dt_nm, $dt_lt)) { $dt_change = vrai }
                          }
                        }
                      }
                    }
                    $dka2 = $dka2 + 1
                  }
                }
              }
            }
          }
        }
        $zq = $zq + 1
      }
      $zi = $zi + 1
    }
  }

  // ---------- deuxième passe : émission des corps ----------
  $i_t = 1
  tant_que ($i_t < $n) {
    $l = trim($ls[$i_t])
    si (commence_par($l, "fonction ")) {
      $nom = nom_fonction($l)
      $cname = c_name($nom)
      $ty = type_retour($l)
      $cret = lettre_retour($l)
      si ($cname == "main") { $ty = "int" }
      // signature
      $rest = trim(sous_chaine($l, 9, longueur($l)))
      $k0 = 0
      tant_que ($k0 < longueur($rest) et $rest[$k0] != '(') { $k0 = $k0 + 1 }
      $k1 = $k0
      tant_que ($k1 < longueur($rest) et $rest[$k1] != ')') { $k1 = $k1 + 1 }
      $pr = ""
      si ($k1 > $k0) { $pr = sous_chaine($rest, $k0+1, $k1) }
      // paramètres du cadre (pour genre + conversions)
      $pnoms = [""]
      $pletres = ""
      $sig = $ty + " " + $cname + "("
      si ($cname == "main") {
        $sig = $sig + "int argc, char **argv"
      } sinon {
        $pp_t = trim($pr)
        si (longueur($pp_t) > 0) {
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($pp_t)) {
            $ch = $pp_t[$k_t]
            si ($ch == ',') { joindre($parts, trim($cur)); $cur = "" }
            sinon { $cur = $cur + $ch }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          $first = vrai
          $pk = 1
          tant_que ($pk < longueur($parts)) {
            $part = $parts[$pk]
            $pct = 0
            tant_que ($pct < longueur($part) et $part[$pct] != '%') { $pct = $pct + 1 }
            $after = trim(sous_chaine($part, $pct, longueur($part)))
            $sp = 0
            tant_que ($sp < longueur($after) et $after[$sp] != ' ' et $after[$sp] != ':') { $sp = $sp + 1 }
            $varname = trim(sous_chaine($after, 0, $sp))
            si (premier_car($varname) == '%') { $varname = sous_chaine($varname, 1, longueur($varname)) }
            si ($first == faux) { $sig = $sig + ", " }
            $first = faux
            $pts = nom_type(lettre_param($part))
            si ($pts == "rose_liste") { $pts = "rose_liste&" }
            $sig = $sig + $pts + " r_" + $varname
            joindre($pnoms, $varname)
            $pletres = $pletres + lettre_param($part)
            $pk = $pk + 1
          }
        }
      }
      $sig = $sig + ")"
      >> $sig + " {"
      si ($cname == "main") {
        si ($recursif) { >> "    rose_pile_geante(argc, argv);" }
        >> "    rose_runtime_set_args(argc, argv);"
      }

      // collect body lines
      // GOMMAGE À GAUCHE SEULEMENT : les constantes cst.s peuvent finir par
      // des espaces — la queue de la ligne est du contenu, pas du bruit.
      $body_lines = [""]
      $i_t = $i_t + 1
      $prof = 1
      tant_que ($i_t < $n et $prof > 0) {
        $ll = $ls[$i_t]
        $d0 = 0
        $dgo = vrai
        tant_que ($dgo) {
          si ($d0 < longueur($ll)) {
            si ($ll[$d0] == ' ') { $d0 = $d0 + 1 }
            sinon { $dgo = faux }
          } sinon { $dgo = faux }
        }
        $ll = sous_chaine($ll, $d0, longueur($ll))
        si ($ll == "}") { $prof = $prof - 1 }
        sinon {
          si (commence_par($ll, "fonction ")) { $prof = $prof + 1 }
        }
        si ($prof > 0) {
          joindre($body_lines, $ll)
        }
        $i_t = $i_t + 1
      }

      // collect temp vars and globals
      // (miroir du transpileur : les temporaires sont les DEST des
      // instructions — jamais les paramètres ni les opérandes sources ;
      // les SLOTS locaux écrits par affect vivent dans la section des
      // variables du corps, comme global_types chez l'oracle)
      $temps = [""]
      $globals = [""]
      $bi = 1
      tant_que ($bi < longueur($body_lines)) {
        $bl = $body_lines[$bi]
        // dest : la ligne commence par « %nom » suivi de « = »
        si (longueur($bl) > 1 et premier_car($bl) == '%') {
          $k_t = 1
          $cont = vrai
          tant_que ($k_t < longueur($bl) et $cont) {
            $ch = $bl[$k_t]
            si (($ch >= 'a' et $ch <= 'z') ou ($ch >= 'A' et $ch <= 'Z') ou ($ch >= '0' et $ch <= '9') ou $ch == '_') {
              $k_t = $k_t + 1
            } sinon {
              $cont = faux
            }
          }
          $tok = sous_chaine($bl, 0, $k_t)
          $restc = trim(sous_chaine($bl, $k_t, longueur($bl)))
          si (commence_par($restc, "=")) {
            $found = faux
            $ti = 1
            tant_que ($ti < longueur($temps)) {
              si ($temps[$ti] == $tok) { $found = vrai }
              $ti = $ti + 1
            }
            si ($found == faux) { joindre($temps, $tok) }
          }
        }
        // collect globals from "affect %t \"name\""
        si (commence_par($bl, "affect ")) {
          // affect %t0 "x" -> global "x"
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($bl)) {
            $ch = $bl[$k_t]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          // parts: ["", "affect", "%t0", "\"x\""]
          si (longueur($parts) >= 4) {
            $gname = $parts[3]
            // strip quotes
            $gname = trim($gname)
            si (premier_car($gname) == '"') {
              $gname = sous_chaine($gname, 1, longueur($gname)-1)
            }
            $found = faux
            $gi = 1
            tant_que ($gi < longueur($globals)) {
              si ($globals[$gi] == $gname) { $found = vrai }
              $gi = $gi + 1
            }
            si ($found == faux et longueur($gname) > 0) {
              // un nom qui EST déjà paramètre du cadre n'est pas une
              // globale : le transpileur traite l'affect comme une écriture
              // du paramètre (L() au fil de l'eau, pas de rose_lit).
              $deja_param = faux
              $px = 1
              tant_que ($px < longueur($pnoms)) {
                si ($pnoms[$px] == $gname) { $deja_param = vrai }
                $px = $px + 1
              }
              si ($deja_param == faux) { joindre($globals, $gname) }
            }
          }
        }
        $bi = $bi + 1
      }

      // tri lexicographique des temporaires (le transpileur utilise std::set)
      // tri par selection, reconstruction de liste (pas d'affectation par index)
      $sorted = [""]
      $remaining = [""]
      $ri = 1
      tant_que ($ri < longueur($temps)) {
        joindre($remaining, $temps[$ri])
        $ri = $ri + 1
      }
      $rcount = longueur($remaining) - 1
      tant_que ($rcount > 0) {
        $minidx = 1
        $mi = 2
        tant_que ($mi < longueur($remaining)) {
          si ($remaining[$mi] < $remaining[$minidx]) {
            $minidx = $mi
          }
          $mi = $mi + 1
        }
        joindre($sorted, $remaining[$minidx])
        $newrem = [""]
        $mi = 1
        tant_que ($mi < longueur($remaining)) {
          si ($mi != $minidx) {
            joindre($newrem, $remaining[$mi])
          }
          $mi = $mi + 1
        }
        $remaining = $newrem
        $rcount = $rcount - 1
      }
      $temps = $sorted

      // tri lexicographique des globales (le transpileur utilise std::map)
      $sortedg = [""]
      $remg = [""]
      $rgi = 1
      tant_que ($rgi < longueur($globals)) {
        joindre($remg, $globals[$rgi])
        $rgi = $rgi + 1
      }
      $rcg = longueur($remg) - 1
      tant_que ($rcg > 0) {
        $midx = 1
        $mj = 2
        tant_que ($mj < longueur($remg)) {
          si ($remg[$mj] < $remg[$midx]) { $midx = $mj }
          $mj = $mj + 1
        }
        joindre($sortedg, $remg[$midx])
        $newremg = [""]
        $mj = 1
        tant_que ($mj < longueur($remg)) {
          si ($mj != $midx) { joindre($newremg, $remg[$mj]) }
          $mj = $mj + 1
        }
        $remg = $newremg
        $rcg = $rcg - 1
      }
      $globals = $sortedg

      // Miroir des flagpees du transpiler (v3.14) : une globale n'est
      // CERTAINE que si elle reçoit un affect dans le préfixe linéaire du
      // corps (avant la première branche), sans lecture antérieure. Les
      // autres portent un drapeau _def_r_x : écriture = pose + drapeau,
      // lecture = rose_lit (garde).
      $flagpees = [""]
      $cert = [""]
      $ligne = vrai
      $fi0 = 1
      tant_que ($fi0 < longueur($body_lines) et $ligne == vrai) {
        $bl0 = $body_lines[$fi0]
        $tk0 = [""]
        decoupe($bl0, $tk0)
        $est_aff0 = faux
        si (longueur($tk0) >= 4) {
          si ($tk0[1] == "affect") { $est_aff0 = vrai }
        }
        $de0 = 2
        si (longueur($tk0) >= 3) {
          si ($tk0[2] == "=") { $de0 = 4 }
        }
        $ft0 = $de0
        tant_que ($ft0 < longueur($tk0)) {
          $a0 = $tk0[$ft0]
          si (commence_par($a0, "%")) {
            $an0 = sous_chaine($a0, 1, longueur($a0))
            $gts = faux
            $gt0 = 1
            tant_que ($gt0 < longueur($globals)) {
              si ($globals[$gt0] == $an0) { $gts = vrai }
              $gt0 = $gt0 + 1
            }
            $deja = faux
            $c0 = 1
            tant_que ($c0 < longueur($cert)) {
              si ($cert[$c0] == $an0) { $deja = vrai }
              $c0 = $c0 + 1
            }
            si ($gts) {
              si ($deja == faux) {
                $fd = faux
                $f1 = 1
                tant_que ($f1 < longueur($flagpees)) {
                  si ($flagpees[$f1] == $an0) { $fd = vrai }
                  $f1 = $f1 + 1
                }
                si ($fd == faux) { joindre($flagpees, $an0) }
              }
            }
          }
          $ft0 = $ft0 + 1
        }
        si ($est_aff0) {
          $wn0 = $tk0[3]
          si (longueur($wn0) > 0) {
            si ($wn0[0] == '"') { $wn0 = sous_chaine($wn0, 1, longueur($wn0) - 1) }
          }
          $cd = faux
          $c1 = 1
          tant_que ($c1 < longueur($cert)) {
            si ($cert[$c1] == $wn0) { $cd = vrai }
            $c1 = $c1 + 1
          }
          si ($cd == faux) { joindre($cert, $wn0) }
        }
        si (longueur($tk0) >= 2) {
          si ($tk0[1] == "br" ou $tk0[1] == "br.cond") { $ligne = faux }
        }
        $fi0 = $fi0 + 1
      }
      $gt1 = 1
      tant_que ($gt1 < longueur($globals)) {
        $gg = $globals[$gt1]
        $vv = faux
        $c2 = 1
        tant_que ($c2 < longueur($cert)) {
          si ($cert[$c2] == $gg) { $vv = vrai }
          $c2 = $c2 + 1
        }
        si ($vv == faux) {
          $fd2 = faux
          $f2 = 1
          tant_que ($f2 < longueur($flagpees)) {
            si ($flagpees[$f2] == $gg) { $fd2 = vrai }
            $f2 = $f2 + 1
          }
          si ($fd2 == faux) { joindre($flagpees, $gg) }
        }
        $gt1 = $gt1 + 1
      }
      // declare globals with type inference
      $gi = 1
      tant_que ($gi < longueur($globals)) {
        $gname = $globals[$gi]
        // Type de la PREMIÈRE écriture de cette variable : genre résout la
        // source quel qu'en soit le nature — paramètre, constante, temp ou
        // autre globale — comme temp_types["%nom"] chez l'oracle.
        $gtype = "z"
        $gtrouve = faux
        $bi = 1
        tant_que ($bi < longueur($body_lines) et $gtrouve == faux) {
          $bl = $body_lines[$bi]
          si (commence_par($bl, "affect ")) {
            $parts = [""]
            $cur = ""
            $k_t = 0
            tant_que ($k_t < longueur($bl)) {
              $ch = $bl[$k_t]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k_t = $k_t + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
            si (longueur($parts) >= 4) {
              $gn = $parts[3]
              si (premier_car($gn) == '"') {
                $gn = sous_chaine($gn, 1, longueur($gn)-1)
              }
              si ($gn == $gname) {
                $gtype = genre_t($parts[2], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                $gtrouve = vrai
              }
            }
          }
          $bi = $bi + 1
        }
        $ct = cpp_type_name($gtype)
        si ($ct == "rose_str") {
          >> "    " + $ct + " r_" + $gname + " = \"\";"
        } sinon si ($ct == "rose_liste" ou $ct == "rose_tampon" ou $ct == "rose_table" ou $ct == "rose_dyn") {
          >> "    " + $ct + " r_" + $gname + ";"
        } sinon {
          >> "    " + $ct + " r_" + $gname + " = 0;"
        }
        $gi = $gi + 1
      }
      si (longueur($globals) > 1) { >> "" }
      $fi2 = 1
      tant_que ($fi2 < longueur($flagpees)) {
        >> "    bool _def_r_" + $flagpees[$fi2] + " = false;"
        $fi2 = $fi2 + 1
      }
      si (longueur($flagpees) > 1) { >> "" }

      // declare temps with type inference
      $ti = 1
      tant_que ($ti < longueur($temps)) {
        $t_t = $temps[$ti]
        $tn = sous_chaine($t_t, 1, longueur($t_t))
        // genre() porte l'inférence complète (miroir de ty_of + dest_ty).
        $tty = genre_t($t_t, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
        si ($tty == "r") { $tty = $cret }
        si ($tty == "z") {
          // un temp de production inconnue (ex. hors corps) reste entier
        }
        $ct = cpp_type_name($tty)
        si ($tty == "z") {
          si (inst_est_gd($t_t, $body_lines)) { $ct = "rose_gd" }
        }
        $init = "0"
        si ($ct == "rose_str") { $init = "\"\"" }
        si ($ct == "rose_liste" ou $ct == "rose_tampon" ou $ct == "rose_table" ou $ct == "rose_dyn") {
          >> "    " + $ct + " r_" + $tn + ";"
        } sinon {
          >> "    " + $ct + " r_" + $tn + " = " + $init + ";"
        }
        $ti = $ti + 1
      }
      // emit body instructions
      $bi = 1
      tant_que ($bi < longueur($body_lines)) {
        $bl = $body_lines[$bi]
        si (est_vide($bl)) {
          // rien
        } sinon si (commence_par($bl, "liste.push ")) {
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($bl)) {
            $ch = $bl[$k_t]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 4) {
            $etyp = genre_t($parts[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            >> pousse_texte(operand($parts[2], $flagpees), operand($parts[3], $flagpees), $etyp)
          }
        } sinon si (commence_par($bl, "afficher ")) {
          $arg = trim(sous_chaine($bl, 9, longueur($bl)))
          // miroir exact de la dispatch afficher du transpiler : le type du
          // temp/global gouverne (genre = ty_of + dest_ty).
          $aty = genre_t($arg, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
          si ($aty == "z") {
            >> "    rose_afficher_int(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "q") {
            >> "    rose_afficher_q(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "g") {
            >> "    rose_afficher_gd(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "f") {
            >> "    rose_afficher_float(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "b") {
            >> "    rose_afficher_bool(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "s") {
            >> "    rose_afficher_str(" + operand($arg, $flagpees) + ".c_str());"
          } sinon si ($aty == "t") {
            >> "    rose_afficher_tampon_longueur(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "l") {
            >> "    rose_afficher_liste(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "h") {
            >> "    rose_afficher_table(" + operand($arg, $flagpees) + ");"
          } sinon si ($aty == "y") {
            >> "    " + operand($arg, $flagpees) + ".afficher();"
          } sinon {
            >> "    rose_afficher_int(" + operand($arg, $flagpees) + ");"
          }
        } sinon si ($bl == "ret.u") {
          >> "    return 0;"
        } sinon si (commence_par($bl, "ret ")) {
          $arg = trim(sous_chaine($bl, 4, longueur($bl)))
          >> "    return " + operand($arg, $flagpees) + ";"
        } sinon si (commence_par($bl, ".")) {
          $lbl = trim(sous_chaine($bl, 0, longueur($bl)-1))
          si ($lbl != ".entree") {
            >> "  r__" + sous_chaine($lbl, 1, longueur($lbl)) + ":"
          }
        } sinon si (commence_par($bl, "affect ")) {
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($bl)) {
            $ch = $bl[$k_t]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 4) {
            $srcexpr = operand($parts[2], $flagpees)
            $gname = $parts[3]
            si (premier_car($gname) == '"') {
              $gname = sous_chaine($gname, 1, longueur($gname)-1)
            }
            >> "    r_" + $gname + " = " + $srcexpr + ";"
            $fe = 1
            $marque = faux
            tant_que ($fe < longueur($flagpees)) {
              si ($flagpees[$fe] == $gname) { $marque = vrai }
              $fe = $fe + 1
            }
            si ($marque) { >> "    _def_r_" + $gname + " = true;" }
          }
        } sinon si (commence_par($bl, "br.cond ")) {
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($bl)) {
            $ch = $bl[$k_t]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 5) {
            >> "    if (" + operand($parts[2], $flagpees) + ") goto r__" + sous_chaine($parts[3], 1, longueur($parts[3])) + ";"
            >> "    else goto r__" + sous_chaine($parts[4], 1, longueur($parts[4])) + ";"
          }
        } sinon si (commence_par($bl, "br ")) {
          $parts = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($bl)) {
            $ch = $bl[$k_t]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 3) {
            >> "    goto r__" + sous_chaine($parts[2], 1, longueur($parts[2])) + ";"
          }
        } sinon si (contient_t($bl, " = ")) {
          $eq = 0
          tant_que ($eq + 2 < longueur($bl) et sous_chaine($bl, $eq, $eq+3) != " = ") { $eq = $eq + 1 }
          $dest = trim(sous_chaine($bl, 0, $eq))
          $rest = trim(sous_chaine($bl, $eq+3, longueur($bl)))
          $rtoks = [""]
          $cur = ""
          $k_t = 0
          tant_que ($k_t < longueur($rest)) {
            $ch = $rest[$k_t]
            si ($ch == ' ' ou $ch == '\t') {
              si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k_t = $k_t + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
          $op = ""
          si (longueur($rtoks) > 1) { $op = $rtoks[1] }
          $dname = operand($dest, $flagpees)
          si ($op == "liste.new") {
            >> "    " + $dname + " = rose_liste_new();"
          } sinon si ($op == "liste.push") {
            si (longueur($rtoks) >= 4) {
              $etyr = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
              >> pousse_texte(operand($rtoks[2], $flagpees), operand($rtoks[3], $flagpees), $etyr)
            }
          } sinon si ($op == "index") {
            si (longueur($rtoks) >= 4) {
              $base = operand($rtoks[2], $flagpees)
              $idx = operand($rtoks[3], $flagpees)
              // miroir du transpiler : table -> rose_table_get ; liste ->
              // get_str ou a_entier selon le type de destination ; sinon index
              // de chaine.
              $bty = genre_t($rtoks[2], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
              si ($bty == "h") {
                >> "    " + $dname + " = rose_table_get(" + $base + ", " + $idx + ");"
              } sinon si ($bty == "l") {
                $dty = genre_t($dest, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($dty == "r") { $dty = $cret }
                si ($dty == "s") {
                  >> "    " + $dname + " = rose_liste_get_str(" + $base + ", " + $idx + ");"
                } sinon {
                  >> "    " + $dname + " = rose_a_entier(rose_liste_get_str(" + $base + ", " + $idx + "));"
                }
              } sinon {
                >> "    " + $dname + " = rose_index_str(" + $base + ", " + $idx + ");"
              }
            }
          } sinon si ($op == "cst.f") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si (commence_par($arg, prefix_cst())) {
                $arg = sous_chaine($arg, 2, longueur($arg))
              }
              >> "    " + $dname + " = " + $arg + ";"
            }
          } sinon si ($op == "cst.b") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si ($arg == "vrai") {
                >> "    " + $dname + " = true;"
              } sinon {
                >> "    " + $dname + " = false;"
              }
            }
          } sinon si ($op == "cst.q") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si (commence_par($arg, prefix_cst())) {
                $arg = sous_chaine($arg, 2, longueur($arg))
              }
              >> "    " + $dname + " = rose_qd(\"" + $arg + "\");"
            }
          } sinon si ($op == "cst.z") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si (commence_par($arg, prefix_cst())) {
                $val = sous_chaine($arg, 2, longueur($arg))
                si (cst_promu_gd($val)) {
                  >> "    " + $dname + " = rose_gd(\"" + $val + "\");"
                } sinon {
                  >> "    " + $dname + " = " + $val + ";"
                }
              } sinon {
                >> "    " + $dname + " = " + operand($arg, $flagpees) + ";"
              }
            }
          } sinon si ($op == "add.q" ou $op == "sub.q" ou $op == "mul.q") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            $o = "+"
            si ($op == "sub.q") { $o = "-" }
            si ($op == "mul.q") { $o = "*" }
            >> "    " + $dname + " = " + $a0 + " " + $o + " " + $a1 + ";"
          } sinon si ($op == "div.q" ou $op == "div.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = rose_q_div(rose_q_de(" + $a0 + "), rose_q_de(" + $a1 + "));"
          } sinon si ($op == "add.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = " + $a0 + " + " + $a1 + ";"
          } sinon si ($op == "sub.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = " + $a0 + " - " + $a1 + ";"
          } sinon si ($op == "mul.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = " + $a0 + " * " + $a1 + ";"
          } sinon si ($op == "cst.s") {
            // La constante peut contenir des espaces, des espaces de queue,
            // des guillemets — et même des RETOURS À LA LIGNE (le texte RIR
            // casse alors la ligne : la ligne vide suivante est sa queue).
            $restn = sous_chaine($bl, $eq + 3, longueur($bl))
            $val0 = ""
            si (longueur($restn) > 6) { $val0 = sous_chaine($restn, 6, longueur($restn)) }
            si (longueur($val0) == 0 et $restn == "cst.s ") {
              $nl = faux
              $suiv_t = $bi + 1
              si ($suiv_t < longueur($body_lines)) {
                si (est_vide($body_lines[$suiv_t])) { $nl = vrai }
              }
              si ($nl) {
                >> "    " + $dname + " = \"\\n\";"
              } sinon {
                >> "    " + $dname + " = \"\";"
              }
            } sinon {
              >> "    " + $dname + " = " + chaine_cpp($val0) + ";"
            }
          } sinon si ($op == "affect") {
            // affect %t0 "x" -> r_x = r_t0
            si (longueur($rtoks) > 2) {
              $srcexpr = operand($rtoks[1], $flagpees)
              $gname = $rtoks[2]
              si (premier_car($gname) == '"') {
                $gname = sous_chaine($gname, 1, longueur($gname)-1)
              }
              >> "    r_" + $gname + " = " + $srcexpr + ";"
            }
          } sinon si ($op == "call") {
            si (longueur($rtoks) > 2) {
              $fn = $rtoks[2]
              $fname = $fn
              si (commence_par($fname, "$")) { $fname = sous_chaine($fname, 1, longueur($fname)) }
              // fonction utilisateur ?
              $fidx = 0
              $fk = 1
              tant_que ($fk < longueur($fn_noms)) {
                si ($fn_noms[$fk] == $fname) { $fidx = $fk }
                $fk = $fk + 1
              }
              si ($fidx > 0) {
                $rty = $fn_rets[$fidx]
                $pars = $fn_pars[$fidx]
                $call = "r_" + $fname + "("
                $first = vrai
                $ai = 3
                $pi2 = 0
                tant_que ($ai < longueur($rtoks)) {
                  $argtok = $rtoks[$ai]
                  $atxt = operand($argtok, $flagpees)
                  $aty = genre_t($argtok, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                  $pty = "z"
                  si ($pi2 < longueur($pars)) { $pty = $pars[$pi2] }
                  si ($pty == "g") {
                    si ($aty == "z" ou $aty == "u") {
                      si (commence_par($argtok, prefix_cst()) == faux) { $atxt = "rose_vers_mpz(" + $atxt + ")" }
                    }
                  }
                  si ($pty == "z") {
                    si ($aty == "f") { $atxt = "rose_depuis_double(" + $atxt + ")" }
                  }
                  si ($pty == "f") {
                    si ($aty == "z" ou $aty == "u") {
                      si (commence_par($argtok, prefix_cst()) == faux) { $atxt = "rose_vers_double(" + $atxt + ")" }
                    }
                  }
                  si ($first == faux) { $call = $call + ", " }
                  $first = faux
                  $call = $call + $atxt
                  $pi2 = $pi2 + 1
                  $ai = $ai + 1
                }
                $call = $call + ")"
                $dty = genre_t($dest, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($dty == "g") {
                  si ($rty == "z" ou $rty == "u") {
                    >> "    " + $dname + " = rose_vers_mpz(" + $call + ");"
                  } sinon {
                    >> "    " + $dname + " = " + $call + ";"
                  }
                } sinon si ($dty == "z") {
                  si ($rty == "f") {
                    >> "    " + $dname + " = rose_depuis_double(" + $call + ");"
                  } sinon {
                    >> "    " + $dname + " = " + $call + ";"
                  }
                } sinon si ($dty == "f") {
                  si ($rty == "z" ou $rty == "u") {
                    >> "    " + $dname + " = rose_vers_double(" + $call + ");"
                  } sinon {
                    >> "    " + $dname + " = " + $call + ";"
                  }
                } sinon {
                  >> "    " + $dname + " = " + $call + ";"
                }
              } sinon si ($fname == "joindre") {
                // miroir : constante entière -> push_int ; gd -> push_gd ;
                // sinon selon le genre de l'élément.
                $lst = operand($rtoks[3], $flagpees)
                $el = $rtoks[4]
                si (commence_par($el, prefix_cst())) {
                  $vj = sous_chaine($el, 2, longueur($el))
                  si (contient_t($vj, "/") == faux et contient_t($vj, ".") == faux) {
                    si (cst_promu_gd($vj)) {
                      >> "    rose_liste_push_gd(" + $lst + ", rose_gd(\"" + $vj + "\"));"
                    } sinon {
                      >> "    rose_liste_push_int(" + $lst + ", " + $vj + ");"
                    }
                  } sinon {
                    >> "    rose_liste_push(" + $lst + ", " + operand($el, $flagpees) + ".c_str());"
                  }
                } sinon {
                  $ety = genre_t($el, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                  si ($ety == "g") {
                    >> "    rose_liste_push_gd(" + $lst + ", " + operand($el, $flagpees) + ");"
                  } sinon si ($ety == "q") {
                    >> "    rose_liste_push_q(" + $lst + ", " + operand($el, $flagpees) + ");"
                  } sinon si ($ety == "f") {
                    >> "    rose_liste_push_flt(" + $lst + ", " + operand($el, $flagpees) + ");"
                  } sinon si ($ety == "z") {
                    >> "    rose_liste_push_int(" + $lst + ", " + operand($el, $flagpees) + ");"
                  } sinon {
                    >> "    rose_liste_push(" + $lst + ", " + operand($el, $flagpees) + ".c_str());"
                  }
                }
              } sinon si ($fname == "ordre") {
                >> "    " + $dname + " = rose_ordre(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "caractere") {
                >> "    " + $dname + " = rose_caractere(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "sous_chaine") {
                >> "    " + $dname + " = rose_sous_chaine(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ", " + operand($rtoks[5], $flagpees) + ");"
              } sinon si ($fname == "duree") {
                >> "    " + $dname + " = rose_duree(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "concatener") {
                >> "    " + $dname + " = rose_liste_concat(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "longueur") {
                $argl = ""
                si (longueur($rtoks) > 3) { $argl = $rtoks[3] }
                $lty = genre_t($argl, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($lty == "l") {
                  >> "    " + $dname + " = rose_liste_len(" + operand($argl, $flagpees) + ");"
                } sinon si ($lty == "t") {
                  >> "    " + $dname + " = rose_tampon_longueur(" + operand($argl, $flagpees) + ");"
                } sinon si ($lty == "h") {
                  >> "    " + $dname + " = rose_table_longueur(" + operand($argl, $flagpees) + ");"
                } sinon si ($lty == "s") {
                  >> "    " + $dname + " = rose_longueur(" + operand($argl, $flagpees) + ");"
                } sinon {
                  >> "    " + $dname + " = " + operand($argl, $flagpees) + ".size();"
                }
              } sinon si ($fname == "entier") {
                $arge = $rtoks[3]
                $eti = genre_t($arge, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si (commence_par($arge, prefix_cst())) {
                  >> "    " + $dname + " = " + operand($arge, $flagpees) + ";"
                } sinon si ($eti == "f") {
                  >> "    " + $dname + " = rose_entier_f(" + operand($arge, $flagpees) + ");"
                } sinon si ($eti == "q") {
                  >> "    " + $dname + " = rose_entier_q(" + operand($arge, $flagpees) + ");"
                } sinon si ($eti == "s" ou $eti == "u") {
                  >> "    " + $dname + " = rose_entier(" + operand($arge, $flagpees) + ".c_str());"
                } sinon {
                  >> "    " + $dname + " = " + operand($arge, $flagpees) + ";"
                }
              } sinon si ($fname == "flottant") {
                $argf = $rtoks[3]
                $ffi = genre_t($argf, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si (commence_par($argf, prefix_cst())) {
                  >> "    " + $dname + " = " + operand($argf, $flagpees) + ";"
                } sinon si ($ffi == "s" ou $ffi == "u") {
                  >> "    " + $dname + " = rose_flottant_chaine(" + operand($argf, $flagpees) + ");"
                } sinon si ($ffi == "b") {
                  >> "    " + $dname + " = (" + operand($argf, $flagpees) + " ? 1.0 : 0.0);"
                } sinon si ($ffi == "f") {
                  >> "    " + $dname + " = " + operand($argf, $flagpees) + ";"
                } sinon {
                  >> "    " + $dname + " = rose_vers_double(" + operand($argf, $flagpees) + ");"
                }
              } sinon si ($fname == "chaine") {
                $argc = $rtoks[3]
                $cti = genre_t($argc, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($cti == "q") {
                  >> "    " + $dname + " = rose_texte_q_ab(" + operand($argc, $flagpees) + ");"
                } sinon si ($cti == "f") {
                  >> "    " + $dname + " = rose_texte_flt(" + operand($argc, $flagpees) + ");"
                } sinon si ($cti == "g") {
                  >> "    " + $dname + " = std::string(" + operand($argc, $flagpees) + ".get_str().c_str());"
                } sinon si ($cti == "s") {
                  >> "    " + $dname + " = " + operand($argc, $flagpees) + ";"
                } sinon si ($cti == "b") {
                  >> "    " + $dname + " = (" + operand($argc, $flagpees) + " ? \"vrai\" : \"faux\");"
                } sinon {
                  >> "    " + $dname + " = rose_chaine(" + operand($argc, $flagpees) + ");"
                }
              } sinon si ($fname == "pgcd" ou $fname == "ppcm") {
                $a0 = operand($rtoks[3], $flagpees)
                $a1 = operand($rtoks[4], $flagpees)
                $g0 = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                $g1 = genre_t($rtoks[4], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                $fnn = "rose_pgcd"
                si ($fname == "ppcm") { $fnn = "rose_ppcm" }
                si ($g0 == "g" ou $g1 == "g") {
                  >> "    " + $dname + " = " + $fnn + "_gd(" + $a0 + ", " + $a1 + ");"
                } sinon {
                  >> "    " + $dname + " = " + $fnn + "(" + $a0 + ", " + $a1 + ");"
                }
              } sinon si ($fname == "factorielle") {
                >> "    " + $dname + " = rose_factorielle_gd(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "fibonacci") {
                >> "    " + $dname + " = rose_fibonacci_gd(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "puissance") {
                >> "    " + $dname + " = rose_puissance_gd(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ");"
              } sinon si ($fname == "est_premier") {
                >> "    " + $dname + " = rose_est_premier(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "compter_premiers") {
                >> "    " + $dname + " = rose_compter_premiers(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "nombre_pi") {
                >> "    " + $dname + " = rose_nombre_pi(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "partie_entiere") {
                $argp = $rtoks[3]
                $pty2 = genre_t($argp, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($pty2 == "f") {
                  >> "    " + $dname + " = rose_partie_entiere_f(" + operand($argp, $flagpees) + ");"
                } sinon si ($pty2 == "q") {
                  >> "    " + $dname + " = rose_partie_entiere_q(" + operand($argp, $flagpees) + ");"
                } sinon {
                  >> "    " + $dname + " = " + operand($argp, $flagpees) + ";"
                }
              } sinon si ($fname == "nb_chiffres") {
                $argn = $rtoks[3]
                $nty = genre_t($argn, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($nty == "g") {
                  >> "    " + $dname + " = rose_nb_chiffres_gd(" + operand($argn, $flagpees) + ");"
                } sinon {
                  >> "    " + $dname + " = rose_nb_chiffres(" + operand($argn, $flagpees) + ");"
                }
              } sinon si ($fname == "hasard") {
                >> "    " + $dname + " = rose_hasard(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "abs") {
                $arga = $rtoks[3]
                $agy = genre_t($arga, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                si ($agy == "f") {
                  >> "    " + $dname + " = rose_abs_f(" + operand($arga, $flagpees) + ");"
                } sinon si ($agy == "g") {
                  >> "    " + $dname + " = rose_abs_gd(" + operand($arga, $flagpees) + ");"
                } sinon si ($agy == "q") {
                  >> "    " + $dname + " = rose_abs_q(" + operand($arga, $flagpees) + ");"
                } sinon {
                  >> "    " + $dname + " = rose_abs(" + operand($arga, $flagpees) + ");"
                }
              } sinon si ($fname == "min" ou $fname == "max") {
                $arg0 = operand($rtoks[3], $flagpees)
                $arg1 = operand($rtoks[4], $flagpees)
                $tg0 = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                $tg1 = genre_t($rtoks[4], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
                $estmin = 1
                si ($fname == "max") { $estmin = 0 }
                si ($tg0 == "f" ou $tg1 == "f") {
                  $x0 = $arg0
                  $x1 = $arg1
                  si ($tg0 != "f") { $x0 = "rose_vers_double(" + $arg0 + ")" }
                  si ($tg1 != "f") { $x1 = "rose_vers_double(" + $arg1 + ")" }
                  si ($estmin == 1) {
                    >> "    " + $dname + " = (" + $x0 + " > " + $x1 + " ? " + $x1 + " : " + $x0 + ");"
                  } sinon {
                    >> "    " + $dname + " = (" + $x0 + " < " + $x1 + " ? " + $x1 + " : " + $x0 + ");"
                  }
                } sinon si ($tg0 == "q" ou $tg1 == "q") {
                  $fq = "rose_min_q"
                  si ($estmin == 0) { $fq = "rose_max_q" }
                  >> "    " + $dname + " = " + $fq + "(" + $arg0 + ", " + $arg1 + ");"
                } sinon si ($tg0 == "g" ou $tg1 == "g") {
                  $fg = "rose_min_gd"
                  si ($estmin == 0) { $fg = "rose_max_gd" }
                  >> "    " + $dname + " = " + $fg + "(" + $arg0 + ", " + $arg1 + ");"
                } sinon {
                  $fp = "rose_min"
                  si ($estmin == 0) { $fp = "rose_max" }
                  >> "    " + $dname + " = " + $fp + "(" + $arg0 + ", " + $arg1 + ");"
                }
              } sinon si ($fname == "fraction") {
                >> "    " + $dname + " = rose_qd(rose_q_de(" + operand($rtoks[3], $flagpees) + ") / rose_q_de(" + operand($rtoks[4], $flagpees) + "));"
              } sinon si ($fname == "millisecondes") {
                >> "    " + $dname + " = rose_millisecondes();"
              } sinon si ($fname == "temps") {
                >> "    " + $dname + " = rose_temps();"
              } sinon si ($fname == "nb_arguments") {
                >> "    " + $dname + " = rose_nb_arguments();"
              } sinon si ($fname == "argument") {
                >> "    " + $dname + " = rose_argument(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "octets") {
                $argo = $rtoks[3]
                $txt_t = operand($argo, $flagpees)
                si (commence_par($argo, "%")) { $txt_t = operand($argo, $flagpees) + ".c_str()" }
                si (commence_par($argo, prefix_cst())) { $txt_t = "\"" + operand($argo, $flagpees) + "\"" }
                >> "    " + $dname + " = rose_octets(" + $txt_t + ");"
              } sinon si ($fname == "tampon") {
                >> "    " + $dname + " = rose_tampon_new(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "remplir_hasard") {
                >> "    rose_remplir_hasard(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ");"
              } sinon si ($fname == "tampon_case") {
                >> "    " + $dname + " = rose_tampon_case(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ");"
              } sinon si ($fname == "tampon_pose") {
                >> "    rose_tampon_pose(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ", " + operand($rtoks[5], $flagpees) + ");"
              } sinon si ($fname == "table") {
                >> "    " + $dname + " = rose_table_new();"
              } sinon si ($fname == "inserer") {
                >> "    rose_table_inserer(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ", rose_dyn_de(" + operand($rtoks[5], $flagpees) + "));"
              } sinon si ($fname == "cle_existe") {
                >> "    " + $dname + " = rose_table_cle_existe(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ");"
              } sinon si ($fname == "supprimer") {
                >> "    " + $dname + " = rose_table_supprimer(" + operand($rtoks[3], $flagpees) + ", " + operand($rtoks[4], $flagpees) + ");"
              } sinon si ($fname == "cles") {
                >> "    " + $dname + " = rose_table_cles(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "valeurs") {
                >> "    " + $dname + " = rose_table_valeurs(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "graine") {
                >> "    rose_graine(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "lire_texte") {
                >> "    " + $dname + " = rose_lire_texte(" + operand($rtoks[3], $flagpees) + ");"
              } sinon si ($fname == "quitter") {
                >> "    rose_quitter(" + operand($rtoks[3], $flagpees) + ");"
              } sinon {
                $call = "r_" + $fname + "("
                $first = vrai
                $ai = 3
                tant_que ($ai < longueur($rtoks)) {
                  si ($first == faux) { $call = $call + ", " }
                  $first = faux
                  $call = $call + operand($rtoks[$ai], $flagpees)
                  $ai = $ai + 1
                }
                $call = $call + ")"
                >> "    " + $dname + " = " + $call + ";"
              }
            }
          } sinon si (commence_par($op, "divf")) {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            $ty0 = genre_t($rtoks[2], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            $ty1 = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            si ($ty0 == "f" ou $ty1 == "f") {
              $x0 = $a0; $x1 = $a1
              si ($ty0 != "f" et ($ty0 == "z" ou $ty0 == "u")) { $x0 = "rose_vers_double(" + $a0 + ")" }
              si ($ty1 != "f" et ($ty1 == "z" ou $ty1 == "u")) { $x1 = "rose_vers_double(" + $a1 + ")" }
              >> "    " + $dname + " = rose_divflo_f(" + $x0 + ", " + $x1 + ");"
            } sinon si ($ty0 == "q" ou $ty1 == "q") {
              >> "    " + $dname + " = rose_div_florentin_q(" + $a0 + ", " + $a1 + ");"
            } sinon si ($ty0 == "g" ou $ty1 == "g") {
              >> "    " + $dname + " = rose_div_florentin_gd(" + $a0 + ", " + $a1 + ");"
            } sinon {
              >> "    " + $dname + " = rose_div_florentin(" + $a0 + ", " + $a1 + ");"
            }
          } sinon si (commence_par($op, "pow.")) {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            $ty0 = genre_t($rtoks[2], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            $ty1 = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            si ($ty1 == "f") {
              si ($ty0 != "f") { $a0 = "rose_vers_double(" + $a0 + ")" }
              >> "    " + $dname + " = std::pow(" + $a0 + ", " + $a1 + ");"
            } sinon si ($ty0 == "f") {
              si ($ty1 != "f") { $a1 = "rose_vers_double(" + $a1 + ")" }
              >> "    " + $dname + " = std::pow(" + $a0 + ", " + $a1 + ");"
            } sinon {
              >> "    " + $dname + " = rose_puissance_gd(" + $a0 + ", " + $a1 + ");"
            }
          } sinon si (commence_par($op, "rem.")) {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = rose_rem_florentin(" + $a0 + ", " + $a1 + ");"
          } sinon si (commence_par($bl, "br.cond ")) {
            $parts = [""]
            $cur = ""
            $k_t = 0
            tant_que ($k_t < longueur($bl)) {
              $ch = $bl[$k_t]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k_t = $k_t + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
            // parts: ["", "br.cond", "%t", "label1", "label2"]
            si (longueur($parts) >= 5) {
              >> "    if (" + operand($parts[2], $flagpees) + ") goto r_" + trim(sous_chaine($parts[3], 1, longueur($parts[3]))) + ";"
              >> "    else goto r_" + trim(sous_chaine($parts[4], 1, longueur($parts[4]))) + ";"
            }
          } sinon si (commence_par($bl, "br ")) {
            $parts = [""]
            $cur = ""
            $k_t = 0
            tant_que ($k_t < longueur($bl)) {
              $ch = $bl[$k_t]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k_t = $k_t + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
            si (longueur($parts) >= 3) {
              >> "    goto r_" + trim(sous_chaine($parts[2], 1, longueur($parts[2]))) + ";"
            }
          } sinon si (commence_par($bl, "cmp.")) {
            // %t = cmp.lt.z %a %b
            $eq = 0
            tant_que ($eq + 2 < longueur($bl) et sous_chaine($bl, $eq, $eq+3) != " = ") { $eq = $eq + 1 }
            $dest = trim(sous_chaine($bl, 0, $eq))
            $rest = trim(sous_chaine($bl, $eq+3, longueur($bl)))
            $rtoks = [""]
            $cur = ""
            $k_t = 0
            tant_que ($k_t < longueur($rest)) {
              $ch = $rest[$k_t]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k_t = $k_t + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
            $dname = operand($dest, $flagpees)
            si (longueur($rtoks) >= 4) {
              $a0 = operand($rtoks[2], $flagpees)
              $a1 = operand($rtoks[3], $flagpees)
              // règle « flottant dominant » : si un opérande est f, les deux
              // passent en double (miroir exact du transpileur C++, lignes
              // 1120-1150) — cela évite la comparaison Q/Gd/Z en mpq/mpz
              // et reproduit la tolérance 1e-9 de rose_approx_f.
              $ty0 = genre_t($rtoks[2], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
              $ty1 = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
              si ($ty0 == "f" et $ty1 != "f") { $a1 = "rose_vers_double(" + $a1 + ")" }
              si ($ty1 == "f" et $ty0 != "f") { $a0 = "rose_vers_double(" + $a0 + ")" }
              $cmpop = "<"
              si (contient_t($rtoks[1], ".lt.")) { $cmpop = "<" }
              si (contient_t($rtoks[1], ".le.")) { $cmpop = "<=" }
              si (contient_t($rtoks[1], ".gt.")) { $cmpop = ">" }
              si (contient_t($rtoks[1], ".ge.")) { $cmpop = ">=" }
              si (contient_t($rtoks[1], ".eq.")) { $cmpop = "==" }
              si (contient_t($rtoks[1], ".ne.")) { $cmpop = "!=" }
              >> "    " + $dname + " = (" + $a0 + " " + $cmpop + " " + $a1 + ");"
            }
          } sinon si (commence_par($op, "cmp.")) {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            // flottant dominant ici aussi
            $ty0 = genre_t($rtoks[2], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            $ty1 = genre_t($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres, $nom, $dt_fn, $dt_nm, $dt_lt)
            si ($ty0 == "f" et $ty1 != "f") { $a1 = "rose_vers_double(" + $a1 + ")" }
            si ($ty1 == "f" et $ty0 != "f") { $a0 = "rose_vers_double(" + $a0 + ")" }
            $cmpop = "<"
            si (contient_t($op, ".lt.")) { $cmpop = "<" }
            si (contient_t($op, ".le.")) { $cmpop = "<=" }
            si (contient_t($op, ".gt.")) { $cmpop = ">" }
            si (contient_t($op, ".ge.")) { $cmpop = ">=" }
            si (contient_t($op, ".eq.")) { $cmpop = "==" }
            si (contient_t($op, ".ne.")) { $cmpop = "!=" }
            >> "    " + $dname + " = (" + $a0 + " " + $cmpop + " " + $a1 + ");"
          } sinon si ($op == "not.b") {
            si (longueur($rtoks) > 2) {
              >> "    " + $dname + " = !" + operand($rtoks[2], $flagpees) + ";"
            }
          } sinon si ($op == "and.b") {
            $a0 = "false"; $a1 = "false"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = (" + $a0 + " && " + $a1 + ");"
          } sinon si ($op == "or.b") {
            $a0 = "false"; $a1 = "false"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            >> "    " + $dname + " = (" + $a0 + " || " + $a1 + ");"
          } sinon si ($op == "add.f" ou $op == "sub.f" ou $op == "mul.f" ou $op == "div.f" ou $op == "neg.f") {
            $a0 = "0.0"; $a1 = "0.0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3], $flagpees) }
            si ($op == "add.f") { >> "    " + $dname + " = " + $a0 + " + " + $a1 + ";" }
            si ($op == "sub.f") { >> "    " + $dname + " = " + $a0 + " - " + $a1 + ";" }
            si ($op == "mul.f") { >> "    " + $dname + " = " + $a0 + " * " + $a1 + ";" }
            si ($op == "div.f") { >> "    " + $dname + " = rose_div_f(" + $a0 + ", " + $a1 + ");" }
            si ($op == "neg.f") { >> "    " + $dname + " = -" + $a0 + ";" }
          } sinon si ($op == "add.s") {
            $a0 = "\"\""
            $a1 = "\"\""
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2], $flagpees) }
            si (longueur($rtoks) > 3) {
              $tok3 = $rtoks[3]
              si (commence_par($tok3, "%")) { $a1 = operand($tok3, $flagpees) }
              sinon { $a1 = texte_const($tok3) }
            }
            >> "    " + $dname + " = " + $a0 + " + " + $a1 + ";"
          } sinon {
            >> "    /* " + $bl + " */"
          }
        } sinon {
          >> "    /* " + $bl + " */"
        }
        $bi = $bi + 1
      }

      si ($cname == "main") {
        >> "    return 0;"
      }
      >> "}"
      >> ""
    }
    $i_t = $i_t + 1
  }}
